<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>LocalFlow - DeliveryApp</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />
  <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: #f0ede8; display: flex; justify-content: center; min-height: 100vh; }
    #app { width: 100%; max-width: 430px; min-height: 100vh; background: #f5f2ed; position: relative; display: flex; flex-direction: column; overflow: hidden; }

    .page { display: none; flex-direction: column; flex: 1; min-height: 100vh; }
    .page.active { display: flex; }

    /* ===== SPLASH ===== */
    #page-splash {
      background: linear-gradient(135deg, #FF9A00, #FF6200, #FF4000, #FF7A00);
      background-size: 300% 300%;
      animation: bgShimmer 4s ease infinite;
      align-items: center; justify-content: center;
    }
    @keyframes bgShimmer {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    @keyframes circlePulse {
      0%, 100% { transform: scale(1);    box-shadow: 0 0 0 0 rgba(255,255,255,0.15); }
      50%       { transform: scale(1.04); box-shadow: 0 0 0 24px rgba(255,255,255,0); }
    }
    @keyframes motoSlide {
      0%   { transform: scaleX(-1) translateX(80px); opacity: 0; }
      40%  { opacity: 1; }
      75%  { transform: scaleX(-1) translateX(-4px); }
      85%  { transform: scaleX(-1) translateX(3px) rotate(1deg); }
      100% { transform: scaleX(-1) translateX(0px) rotate(0deg); }
    }
    @keyframes motoBounce {
      0%, 100% { transform: scaleX(-1) translateY(0px); }
      50%       { transform: scaleX(-1) translateY(-9px); }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes dotPulse {
      0%, 80%, 100% { transform: scale(1);    opacity: 0.45; }
      40%            { transform: scale(1.55); opacity: 1; }
    }
    @keyframes dashDrift {
      from { transform: translateX(-18px); opacity: 0.35; }
      to   { transform: translateX(18px);  opacity: 0.85; }
    }
    .splash-circle {
      width: 280px; height: 280px; border-radius: 50%;
      background: rgba(255,255,255,0.15);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      animation: circlePulse 2.6s ease-in-out 1s infinite;
    }
    .splash-moto {
      font-size: 82px; line-height: 1;
      animation: motoSlide 0.9s cubic-bezier(.22,.68,0,1.2) 0.2s both,
                 motoBounce 1.7s ease-in-out 1.2s infinite;
      display: inline-block;
    }
    .splash-dash {
      width: 80px; height: 3px; background: rgba(255,255,255,0.6); border-radius: 2px;
      margin: 4px auto 14px;
      animation: dashDrift 1.3s ease-in-out 0.9s infinite alternate;
    }
    .splash-title {
      color: #fff; font-size: 24px; font-weight: 800; letter-spacing: -0.5px;
      animation: fadeUp 0.5s ease 0.85s both;
    }
    .splash-sub {
      color: rgba(255,255,255,0.9); font-size: 11px; font-weight: 600;
      letter-spacing: 3px; text-transform: uppercase; margin-top: 4px;
      animation: fadeUp 0.5s ease 1.05s both;
    }
    .splash-dots {
      display: flex; gap: 8px; margin-top: 32px;
      animation: fadeUp 0.5s ease 1.25s both;
    }
    .dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.4); }
    .dot.active { background: #fff; }
    .dot:nth-child(1) { animation: dotPulse 1.3s ease-in-out 0.0s infinite; }
    .dot:nth-child(2) { animation: dotPulse 1.3s ease-in-out 0.2s infinite; }
    .dot:nth-child(3) { animation: dotPulse 1.3s ease-in-out 0.4s infinite; }

    /* ===== LOGIN ===== */
    #page-login { background: #f5f2ed; align-items: center; justify-content: center; padding: 16px; }
    .login-card { width: 100%; max-width: 380px; background: #fff; border-radius: 20px; box-shadow: 0 4px 24px rgba(0,0,0,0.10); padding: 32px 28px; }
    .login-logo-wrap { display: flex; flex-direction: column; align-items: center; margin-bottom: 20px; }
    .login-logo-circle {
      width: 76px; height: 76px; border-radius: 50%;
      background: linear-gradient(135deg, #FF9A00, #FF6200, #FF4000);
      display: flex; align-items: center; justify-content: center;
      font-size: 38px; margin-bottom: 14px;
      box-shadow: 0 4px 16px rgba(255,110,0,0.35);
    }
    .login-title { font-size: 22px; font-weight: 800; color: #111; text-align: center; }
    .login-sub { font-size: 13px; color: #888; margin-top: 4px; }
    .login-tabs { display: flex; gap: 0; border: 1.5px solid #e5e7eb; border-radius: 12px; overflow: hidden; margin-bottom: 18px; }
    .login-tab { flex: 1; padding: 10px; text-align: center; font-size: 13px; font-weight: 600; cursor: pointer; background: #fff; color: #888; border: none; font-family: 'Inter', sans-serif; transition: all 0.2s; }
    .login-tab.active { background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; }
    .form-group { margin-bottom: 14px; }
    .form-label { display: block; font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 6px; }
    .input-wrap { display: flex; align-items: center; border: 1.5px solid #e5e7eb; border-radius: 12px; padding: 0 12px; background: #fff; }
    .input-wrap:focus-within { border-color: #FF8C00; }
    .input-icon { color: #aaa; margin-right: 8px; flex-shrink: 0; }
    .input-wrap input { flex: 1; padding: 12px 0; font-size: 14px; border: none; outline: none; background: transparent; color: #374151; font-family: 'Inter', sans-serif; }
    .input-wrap input::placeholder { color: #bbb; }
    .error-msg { background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 14px; font-size: 13px; color: #dc2626; margin-bottom: 12px; display: none; }
    .btn-signin { width: 100%; padding: 14px; border-radius: 14px; background: linear-gradient(135deg,#FF9A00,#FF5000); color: #fff; border: none; font-size: 15px; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; margin-top: 4px; transition: opacity 0.2s; box-shadow: 0 4px 14px rgba(255,110,0,0.3); }
    .btn-signin:hover { opacity: 0.9; }

    /* ===== APP SHELL ===== */
    #page-app { flex-direction: column; padding-bottom: 64px; }
    .app-content { flex: 1; display: flex; flex-direction: column; overflow-y: auto; }
    .tab-bar { position: fixed; bottom: 0; width: 100%; max-width: 430px; height: 64px; background: #fff; border-top: 1px solid #f0f0f0; display: flex; z-index: 1000; }
    .tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; cursor: pointer; border: none; background: transparent; font-family: 'Inter', sans-serif; transition: color 0.2s; }
    .tab-item span { font-size: 11px; font-weight: 500; color: #9ca3af; }
    .tab-item svg { color: #9ca3af; }
    .tab-item.active span, .tab-item.active svg { color: #FF6B00; }
    .tab-content { display: none; flex: 1; flex-direction: column; }
    .tab-content.active { display: flex; }

    /* ===== LOJAS HEADER ===== */
    .lojas-header { background: linear-gradient(160deg,#FF8C00 0%,#FF6200 60%,#FF4500 100%); padding: 16px 16px 20px; }
    .lojas-header-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
    .lojas-greeting { color: rgba(255,255,255,0.9); font-size: 13px; font-weight: 600; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
    .lojas-title { color: #fff; font-size: 22px; font-weight: 800; line-height: 1.2; }
    .aovivo-card { background: rgba(255,255,255,0.18); border-radius: 14px; padding: 10px 12px; min-width: 100px; backdrop-filter: blur(4px); flex-shrink: 0; }
    .aovivo-dot-row { display: flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; color: #fff; letter-spacing: 1px; margin-bottom: 6px; }
    .aovivo-dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; animation: dotPulse 1.3s ease-in-out infinite; }
    .aovivo-stats { display: flex; align-items: center; gap: 8px; }
    .aovivo-stat { text-align: center; }
    .aovivo-num { color: #fff; font-size: 18px; font-weight: 800; line-height: 1; }
    .aovivo-label { color: rgba(255,255,255,0.8); font-size: 10px; font-weight: 500; margin-top: 1px; }
    .aovivo-divider { width: 1px; height: 28px; background: rgba(255,255,255,0.3); }
    .search-bar { display: flex; align-items: center; background: #fff; border-radius: 14px; padding: 12px 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 12px; }
    .search-bar svg { color: #aaa; margin-right: 10px; flex-shrink: 0; }
    .search-bar input { flex: 1; border: none; outline: none; font-size: 14px; color: #374151; background: transparent; font-family: 'Inter', sans-serif; }
    .search-bar input::placeholder { color: #bbb; }
    /* Cat pills inside header */
    .cat-pills-header { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin-bottom: 10px; }
    .cat-pills-header::-webkit-scrollbar { display: none; }
    .cat-pill { flex-shrink: 0; display: flex; align-items: center; gap: 5px; padding: 7px 14px; border-radius: 999px; border: 1.5px solid rgba(255,255,255,0.35); font-size: 13px; font-weight: 600; cursor: pointer; background: rgba(255,255,255,0.15); color: #fff; font-family: 'Inter', sans-serif; transition: all 0.2s; }
    .cat-pill.active { background: #fff; color: #FF6B00; border-color: #fff; }
    /* Quick filters */
    .quick-filters { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
    .quick-filters::-webkit-scrollbar { display: none; }
    .quick-filter { flex-shrink: 0; padding: 8px 14px; border-radius: 12px; border: none; font-size: 12px; font-weight: 600; cursor: pointer; font-family: 'Inter',sans-serif; background: rgba(255,255,255,0.2); color: #fff; transition: all 0.2s; }
    .quick-filter.active { background: #fff; color: #FF6B00; }
    /* Icon category bar */
    .icon-cat-bar { background: #fff; border-bottom: 1px solid #f0f0f0; padding: 10px 16px; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
    .icon-cat-bar::-webkit-scrollbar { display: none; }
    .icon-cat { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 12px; border-radius: 14px; border: none; cursor: pointer; font-family: 'Inter',sans-serif; background: transparent; transition: background 0.2s; }
    .icon-cat.active { background: #fff3e0; }
    .icon-cat .ic-img { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; background: #f3f4f6; margin-bottom: 2px; }
    .icon-cat.active .ic-img { background: linear-gradient(135deg,#FF8C00,#FF5000); }
    .icon-cat span { font-size: 10px; font-weight: 600; color: #6b7280; white-space: nowrap; }
    .icon-cat.active span { color: #FF6B00; }
    /* Count row */
    .lojas-count-row { padding: 10px 16px 4px; font-size: 13px; font-weight: 600; color: #6b7280; }
    /* Grid layout */
    .lojas-grid { padding: 8px 12px 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .loja-grid-card { background: #fff; border-radius: 16px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); overflow: hidden; cursor: pointer; transition: box-shadow 0.2s; }
    .loja-grid-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.12); }
    .loja-grid-card:active { transform: scale(0.97); }
    .loja-grid-img { width: 100%; aspect-ratio: 1/0.85; background: linear-gradient(135deg,#fff3e0,#fde8cc); display: flex; align-items: center; justify-content: center; font-size: 48px; overflow: hidden; }
    .loja-grid-img img { width: 100%; height: 100%; object-fit: cover; }
    .loja-grid-body { padding: 10px 10px 12px; }
    .loja-grid-name { font-size: 14px; font-weight: 700; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .loja-grid-desc { font-size: 11px; color: #9ca3af; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .loja-grid-meta { display: flex; align-items: center; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .loja-rating-tag { font-size: 11px; font-weight: 700; color: #FF6B00; display: flex; align-items: center; gap: 3px; }
    .loja-delivery-tag { font-size: 11px; font-weight: 600; color: #6b7280; display: flex; align-items: center; gap: 3px; }
    .loja-delivery-tag.free { color: #16a34a; font-weight: 700; }
    /* Keep old classes for mapa list */
    .lojas-list { padding: 12px 16px; display: flex; flex-direction: column; gap: 12px; }
    .loja-card { background: #fff; border-radius: 16px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); display: flex; align-items: center; gap: 14px; padding: 14px; cursor: pointer; transition: box-shadow 0.2s; }
    .loja-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.12); }
    .loja-card:active { transform: scale(0.98); }
    .loja-logo { width: 54px; height: 54px; border-radius: 14px; background: linear-gradient(135deg,#fff3e0,#ffe0b2); display: flex; align-items: center; justify-content: center; font-size: 26px; flex-shrink: 0; overflow: hidden; }
    .loja-logo img { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; }
    .loja-info { flex: 1; min-width: 0; }
    .loja-name { font-size: 15px; font-weight: 700; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .loja-cat { font-size: 12px; color: #aaa; margin-top: 2px; }
    .loja-desc { font-size: 12px; color: #6b7280; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .loja-meta { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
    .loja-badge { flex-shrink: 0; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .loja-badge.open { background: #fff3e0; color: #FF6B00; }
    .loja-badge.closed { background: #f3f4f6; color: #9ca3af; }
    .stars { color: #FF6B00; font-size: 11px; }
    /* Empty state */
    .empty-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px; }
    .empty-state .empty-icon { font-size: 52px; margin-bottom: 12px; }
    .empty-state p { color: #aaa; font-size: 14px; text-align: center; }
    /* Detail tabs */
    .detail-tabs { display: flex; background: #fff; border-bottom: 1px solid #f0f0f0; }
    .detail-tab { flex: 1; padding: 13px; text-align: center; font-size: 14px; font-weight: 600; cursor: pointer; color: #aaa; border: none; background: none; font-family: 'Inter',sans-serif; border-bottom: 2px solid transparent; transition: all 0.2s; }
    .detail-tab.active { color: #FF6B00; border-bottom-color: #FF6B00; }

    /* ===== STORE DETAIL (sub-page) ===== */
    #tab-loja-detail { overflow-y: auto; }
    .detail-header { padding: 16px 16px 20px; background: linear-gradient(160deg,#FF8C00 0%,#FF6200 60%,#FF5000 100%); }
    .detail-back { color: rgba(255,255,255,0.9); font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 12px; background: none; border: none; font-family: 'Inter',sans-serif; }
    .detail-header-row { display: flex; align-items: center; gap: 14px; }
    .detail-logo { width: 64px; height: 64px; border-radius: 18px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 30px; flex-shrink: 0; overflow: hidden; }
    .detail-logo img { width: 100%; height: 100%; object-fit: cover; border-radius: 18px; }
    .detail-name { color: #fff; font-size: 20px; font-weight: 800; }
    .detail-cat { color: rgba(255,255,255,0.8); font-size: 12px; margin-top: 2px; }
    .detail-desc { color: rgba(255,255,255,0.75); font-size: 12px; margin-top: 4px; }
    .detail-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
    .detail-tag { background: rgba(255,255,255,0.2); color: #fff; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; }
    .products-section { padding: 12px 16px; }
    .section-title { font-size: 12px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; }
    .product-card { background: #fff; border-radius: 16px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); overflow: hidden; margin-bottom: 10px; }
    .product-row { display: flex; gap: 12px; padding: 14px; }
    .product-img { width: 80px; height: 80px; border-radius: 12px; background: #fff3e0; display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0; overflow: hidden; }
    .product-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }
    .product-info { flex: 1; min-width: 0; }
    .product-name { font-size: 14px; font-weight: 700; color: #111; }
    .product-desc { font-size: 12px; color: #6b7280; margin-top: 2px; line-height: 1.4; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .product-price { font-size: 16px; font-weight: 800; color: #FF6B00; margin-top: 4px; }
    .product-stock { font-size: 11px; color: #aaa; }
    .product-controls { display: flex; align-items: center; justify-content: space-between; padding: 0 14px 14px; }
    .btn-add { display: flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 12px; border: none; background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; font-family: 'Inter',sans-serif; }
    .qty-controls { display: flex; align-items: center; gap: 10px; }
    .qty-btn { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #FF6B00; background: #fff; color: #FF6B00; font-size: 18px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1; }
    .qty-btn.plus { background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; border: none; }
    .qty-btn.plus:disabled { opacity: 0.4; }
    .qty-num { font-size: 15px; font-weight: 700; color: #111; min-width: 20px; text-align: center; }
    .qty-total { font-size: 13px; font-weight: 700; color: #FF6B00; }

    /* ===== CART BUTTON ===== */
    .cart-fab { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); width: calc(100% - 32px); max-width: 398px; z-index: 900; }
    .cart-btn { width: 100%; padding: 16px 20px; border-radius: 18px; border: none; background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; font-size: 15px; font-weight: 700; cursor: pointer; font-family: 'Inter',sans-serif; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 6px 20px rgba(255,110,0,0.4); }
    .cart-count-badge { background: rgba(255,255,255,0.25); border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }

    /* ===== MODAL ===== */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 2000; display: none; align-items: flex-end; justify-content: center; }
    .modal-overlay.open { display: flex; }
    .modal-sheet { width: 100%; max-width: 430px; background: #fff; border-radius: 24px 24px 0 0; padding: 20px; max-height: 88vh; overflow-y: auto; }
    .modal-handle { width: 40px; height: 4px; background: #e5e7eb; border-radius: 2px; margin: 0 auto 16px; }
    .modal-title { font-size: 17px; font-weight: 700; color: #111; margin-bottom: 16px; }
    .cart-item-row { display: flex; align-items: center; justify-content: space-between; padding: 6px 0; }
    .cart-item-name { font-size: 13px; color: #374151; }
    .cart-qty-mini { display: flex; align-items: center; gap: 6px; }
    .cart-qty-mini button { width: 24px; height: 24px; border-radius: 50%; border: 1px solid #e5e7eb; background: #fff; cursor: pointer; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .cart-qty-mini .cq-plus { border-color: #FF6B00; color: #FF6B00; }
    .cart-item-price { font-size: 13px; font-weight: 700; color: #111; min-width: 70px; text-align: right; }
    .summary-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 13px; color: #6b7280; }
    .summary-total { display: flex; justify-content: space-between; padding: 8px 0 0; font-size: 15px; font-weight: 800; color: #111; border-top: 1px solid #f0f0f0; margin-top: 4px; }
    .payment-note { font-size: 12px; color: #aaa; margin: 6px 0 14px; }
    .field-input { width: 100%; border: 1.5px solid #e5e7eb; border-radius: 12px; padding: 12px 14px; font-size: 14px; color: #374151; outline: none; background: #fff; font-family: 'Inter',sans-serif; transition: border-color 0.2s; }
    .field-input:focus { border-color: #FF8C00; }
    textarea.field-input { resize: none; }
    .field-label { display: block; font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 6px; }
    .btn-confirm { width: 100%; padding: 16px; border-radius: 16px; border: none; background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; font-size: 15px; font-weight: 700; cursor: pointer; font-family: 'Inter',sans-serif; margin-top: 14px; box-shadow: 0 4px 14px rgba(255,110,0,0.3); }
    .btn-confirm:disabled { opacity: 0.5; cursor: default; }
    .btn-ghost { width: 100%; padding: 12px; border-radius: 12px; border: none; background: none; color: #aaa; font-size: 13px; cursor: pointer; font-family: 'Inter',sans-serif; margin-top: 8px; }
    .divider { height: 1px; background: #f0f0f0; margin: 12px 0; }

    /* ===== SUCCESS ===== */
    .success-screen { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px; text-align: center; }
    .success-emoji { font-size: 72px; margin-bottom: 16px; }
    .success-title { font-size: 22px; font-weight: 800; color: #111; margin-bottom: 8px; }
    .success-sub { font-size: 14px; color: #6b7280; line-height: 1.6; margin-bottom: 28px; }
    .btn-orange { padding: 14px 32px; border-radius: 16px; border: none; background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; font-size: 15px; font-weight: 700; cursor: pointer; font-family: 'Inter',sans-serif; }

    /* ===== REVIEW MODAL ===== */
    .star-row { display: flex; gap: 8px; justify-content: center; margin: 12px 0; }
    .star-btn { font-size: 32px; cursor: pointer; opacity: 0.3; transition: opacity 0.15s, transform 0.15s; background: none; border: none; }
    .star-btn.selected { opacity: 1; transform: scale(1.15); }

    /* ===== MAPA ===== */
    .mapa-search { background: #fff; padding: 12px 16px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); z-index: 10; }
    .mapa-search-inner { display: flex; align-items: center; background: #f3f4f6; border-radius: 12px; padding: 10px 12px; }
    .mapa-search-inner svg { color: #aaa; margin-right: 8px; }
    .mapa-search-inner input { flex: 1; border: none; outline: none; background: transparent; font-size: 14px; color: #374151; font-family: 'Inter',sans-serif; }
    #map { height: 260px; z-index: 1; }
    .nearby-header { padding: 14px 16px 6px; display: flex; align-items: center; justify-content: space-between; }
    .nearby-title { font-size: 15px; font-weight: 700; color: #111; }
    .nearby-count { font-size: 12px; color: #aaa; }

    /* ===== AVALIAÇÕES ===== */
    .aval-header { padding: 20px 16px 24px; background: linear-gradient(160deg,#FF8C00 0%,#FF6200 60%,#FF4500 100%); }
    .aval-header h1 { color: #fff; font-size: 22px; font-weight: 800; margin-bottom: 2px; }
    .aval-header p { color: rgba(255,255,255,0.8); font-size: 13px; }
    .review-card { background: #fff; border-radius: 16px; padding: 14px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); margin-bottom: 10px; }
    .review-store { font-size: 14px; font-weight: 700; color: #111; margin-bottom: 4px; }
    .review-stars { color: #FF6B00; font-size: 14px; }
    .review-comment { font-size: 13px; color: #6b7280; margin-top: 4px; }
    .review-date { font-size: 11px; color: #aaa; margin-top: 4px; }

    /* ===== PERFIL ===== */
    .perfil-wrap { flex: 1; padding: 20px 16px; overflow-y: auto; }
    .perfil-header { display: flex; align-items: center; justify-content: center; font-size: 26px; }
    .perfil-name { font-size: 16px; font-weight: 700; color: #111; }
    .perfil-email { font-size: 12px; color: #aaa; }
    .role-badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: #fff3e0; color: #FF6B00; margin-top: 3px; }
    .btn-logout { background: none; border: none; cursor: pointer; color: #9ca3af; padding: 4px; }
    .card { background: #fff; border-radius: 18px; padding: 16px; box-shadow: 0 1px 6px rgba(0,0,0,0.06); margin-bottom: 14px; }
    .mercantil-row { display: flex; align-items: center; justify-content: space-between; }
    .mercantil-left { display: flex; align-items: center; gap: 12px; }
    .merc-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; background: #f3f4f6; transition: background 0.3s; }
    .merc-icon.on { background: linear-gradient(135deg,#FF8C00,#FF5000); }
    .merc-title { font-size: 14px; font-weight: 600; color: #111; }
    .merc-sub { font-size: 12px; color: #aaa; }
    .toggle-track { width: 48px; height: 26px; border-radius: 13px; background: #e5e7eb; position: relative; transition: background 0.3s; cursor: pointer; flex-shrink: 0; }
    .toggle-track::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,0.2); transition: left 0.3s; }
    .toggle-track.on { background: linear-gradient(135deg,#FF8C00,#FF5000); }
    .toggle-track.on::after { left: 25px; }
    .btn-configurar { width: 100%; padding: 12px; border-radius: 12px; border: none; background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; font-family: 'Inter',sans-serif; transition: opacity 0.2s; }
    .btn-configurar:hover { opacity: 0.9; }
    .card-header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .card-icon { width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg,#FF8C00,#FF5000); display: flex; align-items: center; justify-content: center; font-size: 16px; }
    .card-title { font-size: 15px; font-weight: 700; color: #111; }
    .client-card { display: flex; flex-direction: column; align-items: center; padding: 24px 16px; }

    /* ===== CRIAR LOJA ===== */
    .criar-loja-wrap { flex: 1; padding: 20px 16px; overflow-y: auto; }
    .criar-loja-card { background: #fff; border-radius: 18px; padding: 20px; box-shadow: 0 1px 6px rgba(0,0,0,0.06); }
    .field-group { margin-bottom: 16px; }
    .upload-area { border: 2px dashed #e5e7eb; border-radius: 14px; padding: 16px; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; transition: border-color 0.2s; }
    .upload-area:hover { border-color: #FF8C00; }
    .upload-area span { font-size: 14px; color: #bbb; }
    .upload-preview { width: 64px; height: 64px; object-fit: cover; border-radius: 12px; }
    .select-wrap { position: relative; }
    .select-wrap select { width: 100%; border: 1.5px solid #e5e7eb; border-radius: 12px; padding: 12px 36px 12px 14px; font-size: 14px; color: #374151; outline: none; background: #fff; font-family: 'Inter',sans-serif; appearance: none; cursor: pointer; transition: border-color 0.2s; }
    .select-wrap select:focus { border-color: #FF8C00; }
    .select-arrow { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #aaa; }
    .btn-location { width: 100%; border: 1.5px solid #e5e7eb; border-radius: 12px; padding: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; background: #fff; cursor: pointer; font-size: 14px; color: #6b7280; font-family: 'Inter',sans-serif; transition: background 0.2s; }
    .btn-location:hover { background: #f9fafb; }
    .btn-criar { width: 100%; padding: 16px; border-radius: 18px; border: none; background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; font-size: 16px; font-weight: 700; cursor: pointer; font-family: 'Inter',sans-serif; margin-top: 8px; transition: opacity 0.2s; box-shadow: 0 4px 14px rgba(255,110,0,0.3); }
    .btn-criar:hover { opacity: 0.92; }
    .delivery-box { background: #fff8f0; border-radius: 14px; padding: 14px; margin-bottom: 16px; }
    .delivery-box h4 { font-size: 13px; font-weight: 700; color: #374151; margin-bottom: 10px; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .field-note { font-size: 11px; color: #aaa; margin-top: 4px; }

    /* ===== MERCHANT DASHBOARD ===== */
    .dash-header { padding: 16px 16px 20px; background: linear-gradient(160deg,#FF8C00 0%,#FF6200 60%,#FF5000 100%); }
    .dash-title { color: #fff; font-size: 20px; font-weight: 800; }
    .dash-sub { color: rgba(255,255,255,0.8); font-size: 12px; margin-top: 2px; }
    .dash-badges { display: flex; gap: 8px; margin-top: 10px; }
    .dash-badge { background: rgba(255,255,255,0.2); color: #fff; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px; }
    .dash-badge.alert { background: #ef4444; }
    .dash-tabs { background: #fff; border-bottom: 1px solid #f0f0f0; display: flex; }
    .dash-tab { flex: 1; padding: 12px; text-align: center; font-size: 13px; font-weight: 600; cursor: pointer; color: #aaa; border: none; background: none; font-family: 'Inter',sans-serif; border-bottom: 2px solid transparent; transition: all 0.2s; }
    .dash-tab.active { color: #FF6B00; border-bottom-color: #FF6B00; }
    .dash-content { flex: 1; padding: 14px 16px; overflow-y: auto; }
    .btn-new-product { width: 100%; padding: 14px; border-radius: 16px; border: none; background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; font-size: 14px; font-weight: 700; cursor: pointer; font-family: 'Inter',sans-serif; margin-bottom: 14px; display: flex; align-items: center; justify-content: center; gap: 6px; }
    .prod-manage-card { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 1px 6px rgba(0,0,0,0.07); margin-bottom: 10px; }
    .prod-manage-row { display: flex; gap: 10px; padding: 12px; }
    .prod-manage-img { width: 60px; height: 60px; border-radius: 10px; background: #fff3e0; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; overflow: hidden; }
    .prod-manage-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }
    .prod-manage-info { flex: 1; }
    .prod-manage-name { font-size: 14px; font-weight: 700; color: #111; }
    .prod-manage-price { font-size: 14px; font-weight: 700; color: #FF6B00; margin-top: 2px; }
    .prod-manage-stock { font-size: 11px; color: #aaa; }
    .prod-status-badge { font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 999px; }
    .prod-status-badge.active { background: #dcfce7; color: #16a34a; }
    .prod-status-badge.inactive { background: #f3f4f6; color: #9ca3af; }
    .prod-actions { display: flex; border-top: 1px solid #f0f0f0; }
    .prod-action-btn { flex: 1; padding: 10px; border: none; background: none; cursor: pointer; font-size: 12px; font-weight: 600; font-family: 'Inter',sans-serif; }
    .prod-action-btn.edit { color: #3b82f6; }
    .prod-action-btn.del { color: #ef4444; }
    .prod-action-btn:not(:last-child) { border-right: 1px solid #f0f0f0; }
    .order-card { background: #fff; border-radius: 14px; padding: 14px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); margin-bottom: 10px; }
    .order-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 8px; }
    .order-id { font-size: 14px; font-weight: 700; color: #111; }
    .order-client { font-size: 12px; color: #aaa; }
    .order-date { font-size: 11px; color: #aaa; }
    .status-badge { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px; color: #fff; }
    .order-items-text { font-size: 12px; color: #6b7280; margin-bottom: 6px; line-height: 1.5; }
    .order-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
    .order-address { font-size: 11px; color: #aaa; }
    .order-total { font-size: 14px; font-weight: 700; color: #FF6B00; }
    .btn-next-status { padding: 8px 14px; border-radius: 10px; border: none; background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; font-size: 12px; font-weight: 700; cursor: pointer; font-family: 'Inter',sans-serif; }
    .store-settings-card { background: #fff; border-radius: 14px; padding: 14px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); margin-bottom: 10px; }
    .store-settings-title { font-size: 14px; font-weight: 700; color: #111; margin-bottom: 12px; }
    .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; }
    .toggle-label { font-size: 13px; font-weight: 500; color: #374151; }
    .toggle-sub { font-size: 11px; color: #aaa; }

    /* ===== PRODUCT FORM MODAL ===== */
    .form-upload-row { display: flex; align-items: center; justify-content: center; }
    .form-upload-preview { width: 60px; height: 60px; object-fit: cover; border-radius: 10px; }

    /* ===== MY ORDERS (client) ===== */
    .my-orders-header { padding: 20px 16px 20px; background: linear-gradient(160deg,#FF8C00 0%,#FF6200 60%,#FF4500 100%); }
    .my-orders-header h1 { color: #fff; font-size: 22px; font-weight: 800; }
    .my-orders-header p { color: rgba(255,255,255,0.8); font-size: 13px; margin-top: 2px; }
    .my-order-card { background: #fff; border-radius: 14px; padding: 14px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); margin-bottom: 10px; }
    .my-order-store { font-size: 14px; font-weight: 700; color: #111; }
    .my-order-items { font-size: 12px; color: #6b7280; margin: 4px 0; line-height: 1.5; }
    .my-order-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
    .my-order-total { font-size: 14px; font-weight: 700; color: #FF6B00; }
    .my-order-status { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px; color: #fff; }
    .btn-review { margin-top: 10px; width: 100%; padding: 10px; border-radius: 12px; border: 1.5px solid #FF6B00; background: #fff; color: #FF6B00; font-size: 13px; font-weight: 600; cursor: pointer; font-family: 'Inter',sans-serif; }

    /* ===== TOAST ===== */
    .toast { position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%); background: #1a1a1a; color: #fff; padding: 12px 24px; border-radius: 14px; font-size: 14px; font-weight: 500; box-shadow: 0 4px 16px rgba(0,0,0,0.2); z-index: 9999; opacity: 0; transition: opacity 0.3s; pointer-events: none; white-space: nowrap; }
    .toast.show { opacity: 1; }

    /* ===== ADMIN BADGE ===== */
    .admin-badge { display:inline-flex;align-items:center;gap:4px;background:linear-gradient(135deg,#7c3aed,#4f46e5);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;margin-left:6px; }
    /* ===== RIDE REQUEST MODAL ===== */
    .ride-modal-overlay { position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:3000;display:flex;align-items:flex-end;justify-content:center;opacity:0;pointer-events:none;transition:opacity 0.3s; }
    .ride-modal-overlay.open { opacity:1;pointer-events:all; }
    .ride-modal-sheet { background:#fff;border-radius:24px 24px 0 0;padding:24px 20px 32px;width:100%;max-width:430px;transform:translateY(100%);transition:transform 0.35s cubic-bezier(.34,1.56,.64,1); }
    .ride-modal-overlay.open .ride-modal-sheet { transform:translateY(0); }
    .ride-modal-handle { width:40px;height:4px;background:#e5e7eb;border-radius:2px;margin:0 auto 20px; }
    .ride-modal-moto { display:flex;align-items:center;gap:14px;margin-bottom:20px; }
    .ride-modal-avatar { width:56px;height:56px;background:linear-gradient(135deg,#22c55e,#16a34a);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0; }
    .ride-modal-name { font-size:18px;font-weight:800;color:#111; }
    .ride-modal-sub { font-size:13px;color:#6b7280;margin-top:2px; }
    .ride-price-row { display:flex;align-items:center;justify-content:space-between;background:#f0fdf4;border-radius:14px;padding:14px 16px;margin-bottom:16px; }
    .ride-price-label { font-size:13px;color:#16a34a;font-weight:600; }
    .ride-price-val { font-size:22px;font-weight:800;color:#16a34a; }
    .ride-dest-input { width:100%;border:1.5px solid #e5e7eb;border-radius:14px;padding:12px 14px;font-size:14px;font-family:'Inter',sans-serif;outline:none;margin-bottom:14px;color:#374151;transition:border-color 0.2s; }
    .ride-dest-input:focus { border-color:#FF8C00; }
    .btn-pedir-corrida { width:100%;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border:none;border-radius:16px;padding:15px;font-size:16px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;box-shadow:0 4px 14px rgba(34,197,94,0.35); }
    /* ===== MOTOBOY NOTIFICATION BANNER ===== */
    #motoboy-ride-banner { position:fixed;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:430px;z-index:2000;display:none; }
    .ride-banner-inner { margin:12px;background:#fff;border-radius:18px;box-shadow:0 8px 32px rgba(0,0,0,0.18);overflow:hidden; }
    .ride-banner-top { background:linear-gradient(135deg,#22c55e,#16a34a);padding:12px 16px;display:flex;align-items:center;gap:10px; }
    .ride-banner-icon { font-size:24px; }
    .ride-banner-title { color:#fff;font-size:15px;font-weight:800; }
    .ride-banner-sub { color:rgba(255,255,255,0.85);font-size:12px; }
    .ride-banner-body { padding:12px 16px 16px; }
    .ride-banner-dest { font-size:14px;color:#374151;font-weight:600;margin-bottom:6px; }
    .ride-banner-price { font-size:20px;font-weight:800;color:#16a34a;margin-bottom:14px; }
    .ride-banner-btns { display:flex;gap:10px; }
    .btn-aceitar { flex:1;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border:none;border-radius:12px;padding:12px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif; }
    .btn-recusar { flex:1;background:#f3f4f6;color:#6b7280;border:none;border-radius:12px;padding:12px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif; }
    /* ===== ROUTE PANEL ===== */
    #route-panel { position:fixed;bottom:70px;left:50%;transform:translateX(-50%);width:calc(100% - 24px);max-width:406px;background:#fff;border-radius:18px;box-shadow:0 4px 20px rgba(0,0,0,0.15);padding:14px 16px;z-index:1500;display:none; }
    .route-panel-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:8px; }
    .route-panel-title { font-size:15px;font-weight:700;color:#111; }
    .route-panel-close { background:none;border:none;font-size:20px;cursor:pointer;color:#9ca3af; }
    .route-step { font-size:13px;color:#374151;margin-top:4px; }
    .btn-entreguei { width:100%;background:linear-gradient(135deg,#FF9A00,#FF5000);color:#fff;border:none;border-radius:12px;padding:12px;font-size:14px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;margin-top:12px; }
    /* ===== CHAT TAB ===== */
    .chat-page-header { background: linear-gradient(135deg,#FF9A00,#FF5000); padding: 20px 16px 18px; }
    .chat-page-title { color: #fff; font-size: 22px; font-weight: 800; }
    .chat-page-sub { color: rgba(255,255,255,0.8); font-size: 13px; margin-top: 2px; }
    .chat-list { padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
    .chat-conv-card { background: #fff; border-radius: 16px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); display: flex; align-items: center; gap: 14px; padding: 14px; cursor: pointer; transition: box-shadow 0.2s; }
    .chat-conv-card:active { transform: scale(0.98); }
    .chat-conv-avatar { width: 48px; height: 48px; border-radius: 14px; background: linear-gradient(135deg,#fff3e0,#fde8cc); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; overflow: hidden; }
    .chat-conv-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; }
    .chat-conv-info { flex: 1; min-width: 0; }
    .chat-conv-name { font-size: 15px; font-weight: 700; color: #111; }
    .chat-conv-last { font-size: 12px; color: #9ca3af; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .chat-conv-time { font-size: 11px; color: #bbb; flex-shrink: 0; }
    .chat-unread { background: #FF6B00; color: #fff; font-size: 11px; font-weight: 700; border-radius: 999px; padding: 2px 7px; flex-shrink: 0; }
    .chat-section-label { font-size: 12px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.8px; padding: 0 16px; margin-bottom: -2px; margin-top: 6px; }
    /* Full chat screen */
    .chat-screen { display: none; flex-direction: column; flex: 1; background: #f8f9fa; }
    .chat-screen.active { display: flex; }
    .chat-screen-header { background: #fff; border-bottom: 1px solid #f0f0f0; padding: 12px 16px; display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .chat-back-btn { background: none; border: none; cursor: pointer; font-size: 20px; color: #FF6B00; padding: 4px; }
    .chat-screen-avatar { width: 38px; height: 38px; border-radius: 12px; background: linear-gradient(135deg,#fff3e0,#fde8cc); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; overflow: hidden; }
    .chat-screen-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }
    .chat-screen-name { font-size: 15px; font-weight: 700; color: #111; flex: 1; }
    .chat-screen-status { font-size: 11px; color: #4ade80; font-weight: 600; }
    .chat-messages { flex: 1; overflow-y: auto; padding: 14px 14px 8px; display: flex; flex-direction: column; gap: 8px; }
    .chat-msg { display: flex; align-items: flex-end; gap: 6px; }
    .chat-msg.me { flex-direction: row-reverse; }
    .chat-bubble { max-width: 78%; padding: 9px 13px; font-size: 13px; line-height: 1.5; word-break: break-word; }
    .chat-bubble.them { background: #fff; color: #111; border-radius: 14px 14px 14px 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); }
    .chat-bubble.me { background: linear-gradient(135deg,#FF9A00,#FF5000); color: #fff; border-radius: 14px 14px 4px 14px; }
    .chat-bubble-time { font-size: 10px; opacity: 0.6; margin-top: 3px; text-align: right; }
    .chat-msg-avatar { width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg,#FF9A00,#FF5000); display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; }
    .chat-input-bar { background: #fff; border-top: 1px solid #f0f0f0; padding: 10px 14px; display: flex; gap: 10px; align-items: center; flex-shrink: 0; }
    .chat-input { flex: 1; border: 1.5px solid #e5e7eb; border-radius: 22px; padding: 10px 16px; font-size: 14px; outline: none; font-family: 'Inter',sans-serif; color: #374151; transition: border-color 0.2s; background: #f9fafb; }
    .chat-input:focus { border-color: #FF8C00; background: #fff; }
    .chat-send-btn { width: 42px; height: 42px; border-radius: 50%; border: none; background: linear-gradient(135deg,#FF9A00,#FF5000); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; transition: opacity 0.2s; box-shadow: 0 2px 8px rgba(255,110,0,0.3); }
    .chat-quick { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 4px 14px 10px; }
    .chat-quick::-webkit-scrollbar { display: none; }
    .chat-quick-btn { flex-shrink: 0; padding: 6px 12px; border-radius: 12px; border: 1.5px solid #FFB07C; background: #fff8f0; color: #FF6B00; font-size: 12px; font-weight: 600; cursor: pointer; font-family: 'Inter',sans-serif; white-space: nowrap; }
    .sp-typing span { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #aaa; animation: sp-bounce 1.2s infinite; margin: 0 1px; }
    .sp-typing span:nth-child(2) { animation-delay: 0.2s; }
    .sp-typing span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes sp-bounce { 0%,80%,100%{transform:translateY(0)} 40%{transform:translateY(-5px)} }
  
    /* 🔥 LOADING DAS LOJAS */
    #lojas-loading { padding: 12px 16px; }
    .skeleton { height: 80px; border-radius: 16px; margin-bottom: 10px; background: linear-gradient(90deg, #eee, #ddd, #eee); background-size: 200px 100%; animation: loading 1.2s infinite; }
    @keyframes loading { 0% { background-position: -200px 0; } 100% { background-position: 200px 0; } }

    /* ===== MAPA FILTER ===== */
    .mapa-filter-bar { background: #fff; border-bottom: 1px solid #f0f0f0; padding: 10px 16px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
    .mapa-filter-bar::-webkit-scrollbar { display: none; }
    .mapa-pill { flex-shrink: 0; padding: 7px 14px; border-radius: 999px; border: none; font-size: 13px; font-weight: 600; cursor: pointer; font-family: 'Inter',sans-serif; transition: all 0.2s; background: #f3f4f6; color: #6b7280; display: flex; align-items: center; gap: 5px; }
    .mapa-pill.active { background: linear-gradient(135deg,#FF8C00,#FF5000); color: #fff; }

    /* ===== MOTOBOY ===== */
    .motoboy-card { background: #fff; border-radius: 16px; box-shadow: 0 1px 6px rgba(0,0,0,0.07); display: flex; align-items: center; gap: 14px; padding: 14px; margin-bottom: 10px; }
    .motoboy-avatar { width: 54px; height: 54px; border-radius: 50%; background: linear-gradient(135deg,#22c55e,#16a34a); display: flex; align-items: center; justify-content: center; font-size: 26px; flex-shrink: 0; }
    .motoboy-info { flex: 1; min-width: 0; }
    .motoboy-name { font-size: 15px; font-weight: 700; color: #111; }
    .motoboy-status { font-size: 12px; font-weight: 600; color: #22c55e; display: flex; align-items: center; gap: 4px; margin-top: 2px; }
    .motoboy-status.offline { color: #9ca3af; }
    .motoboy-dot { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; }
    .motoboy-dot.offline { background: #9ca3af; }
    .motoboy-badge { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: #dcfce7; color: #16a34a; }
    .motoboy-badge.offline { background: #f3f4f6; color: #9ca3af; }

    /* Motoboy card no perfil */
    .motoboy-profile-card { background: #fff; border-radius: 18px; padding: 18px; box-shadow: 0 1px 6px rgba(0,0,0,0.06); margin-bottom: 14px; }
    .motoboy-gps-btn { width: 100%; padding: 12px; border-radius: 12px; border: 1.5px solid #22c55e; background: #fff; color: #16a34a; font-size: 14px; font-weight: 600; cursor: pointer; font-family: 'Inter',sans-serif; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 10px; }
    .motoboy-gps-btn.online { background: linear-gradient(135deg,#22c55e,#16a34a); color: #fff; border-color: transparent; }
  </style>
</head>
<body>
<div id="app">
  
  <!-- SPLASH -->
  <div id="page-splash" class="page active">
    <div class="splash-circle">
      <div class="splash-moto">🛵</div>
      <div class="splash-dash"></div>
      <div class="splash-title">DeliveryApp</div>
      <div class="splash-sub">TUDO PERTO DE VOCÊ</div>
    </div>
    <div class="splash-dots">
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot active"></div>
    </div>
  </div>

  <!-- LOGIN -->
  <div id="page-login" class="page">
    <div class="login-card">
      <div class="login-logo-wrap">
        <div class="login-logo-circle">🛵</div>
        <div class="login-title">LocalFlow</div>
        <div class="login-sub" id="login-sub-text">Entre na sua conta</div>
      </div>
      <div class="login-tabs">
        <button class="login-tab active" onclick="setLoginMode('login')">Entrar</button>
        <button class="login-tab" onclick="setLoginMode('register')">Cadastrar</button>
      </div>
      <div class="error-msg" id="login-error"></div>
      <div class="form-group" id="field-name" style="display:none">
        <label class="form-label">Nome completo</label>
        <div class="input-wrap">
          <span class="input-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></span>
          <input type="text" id="input-name" placeholder="Seu nome" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">E-mail</label>
        <div class="input-wrap">
          <span class="input-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></span>
          <input type="email" id="input-email" placeholder="seu@email.com" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Senha</label>
        <div class="input-wrap">
          <span class="input-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg></span>
          <input type="password" id="input-password" placeholder="••••••••" />
        </div>
      </div>
      <button class="btn-signin" id="btn-login" onclick="doLogin()">Entrar</button>
    </div>
  </div>

  <!-- APP SHELL -->
  <div id="page-app" class="page">
    <div class="app-content">

      <!-- LOJAS TAB -->
      <div id="tab-lojas" class="tab-content active">
        <div class="lojas-header">
          <div class="lojas-header-top">
            <div>
              <div class="lojas-greeting" id="lojas-greeting">👋 Olá!</div>
              <div class="lojas-title">O que você quer<br>pedir hoje?</div>
            </div>
            <div class="aovivo-card">
              <div class="aovivo-dot-row"><div class="aovivo-dot"></div> AO VIVO</div>
              <div class="aovivo-stats">
                <div class="aovivo-stat"><div class="aovivo-num" id="aovivo-lojas">0</div><div class="aovivo-label">lojas</div></div>
                <div class="aovivo-divider"></div>
                <div class="aovivo-stat"><div class="aovivo-num" id="aovivo-motoboys">0</div><div class="aovivo-label">motoboys</div></div>
              </div>
            </div>
          </div>
          <div class="search-bar">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" id="search-input" placeholder="Buscar lojas, produtos..." oninput="filterLojas()" />
          </div>
        </div>

        <div class="icon-cat-bar">
          <button class="icon-cat active" onclick="selectIconCat(this,'todas')"><div class="ic-img">🏪</div><span>Todas</span></button>
          <button class="icon-cat" onclick="selectIconCat(this,'restaurante')"><div class="ic-img">🍽️</div><span>Restaurante</span></button>
          <button class="icon-cat" onclick="selectIconCat(this,'mercado')"><div class="ic-img">🛒</div><span>Mercado</span></button>
          <button class="icon-cat" onclick="selectIconCat(this,'farmacia')"><div class="ic-img">💊</div><span>Farmácia</span></button>
          <button class="icon-cat" onclick="selectIconCat(this,'acai')"><div class="ic-img">🍇</div><span>Açaí</span></button>
          <button class="icon-cat" onclick="selectIconCat(this,'padaria')"><div class="ic-img">🍞</div><span>Padaria</span></button>
          <button class="icon-cat" onclick="selectIconCat(this,'pet')"><div class="ic-img">🐾</div><span>Pet</span></button>
          <button class="icon-cat" onclick="selectIconCat(this,'bebidas')"><div class="ic-img">🍺</div><span>Bebidas</span></button>
          <button class="icon-cat" onclick="selectIconCat(this,'outros')"><div class="ic-img">📦</div><span>Outros</span></button>
        </div>

        <div class="lojas-count-row" id="lojas-count-row" style="display:none"></div>
        <div id="lojas-empty" class="empty-state">
          <div class="empty-icon">🔍</div>
          <p>Nenhuma loja encontrada<br><small>Seja o primeiro a cadastrar sua loja!</small></p>
        </div>
        <div id="lojas-loading" style="display:none;padding:12px 12px;display:none">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:12px">
            <div class="skeleton" style="height:160px;border-radius:16px"></div>
            <div class="skeleton" style="height:160px;border-radius:16px"></div>
            <div class="skeleton" style="height:160px;border-radius:16px"></div>
            <div class="skeleton" style="height:160px;border-radius:16px"></div>
          </div>
        </div>
        <div id="lojas-list" class="lojas-grid" style="display:none"></div>
      </div>

      <!-- STORE DETAIL TAB -->
      <div id="tab-loja-detail" class="tab-content">
        <div id="detail-loading" style="display:flex;align-items:center;justify-content:center;padding:60px;flex-direction:column;gap:12px">
          <div style="font-size:48px">🏪</div>
          <div style="color:#aaa;font-size:14px">Carregando...</div>
        </div>
        <div id="detail-content" style="display:none"></div>
      </div>

      <!-- ORDER SUCCESS TAB -->
      <div id="tab-order-success" class="tab-content">
        <div class="success-screen">
          <div class="success-emoji">🎉</div>
          <div class="success-title">Pedido realizado!</div>
          <div class="success-sub">O pagamento é feito <strong>na entrega</strong>, na porta da sua casa em dinheiro ou pix.<br><br>O lojista vai preparar e entregar em breve.</div>
          <button class="btn-orange" onclick="afterOrder()">Voltar às lojas</button>
          <button class="btn-ghost" onclick="switchTab('meus-pedidos')" style="margin-top:10px">Ver meus pedidos</button>
        </div>
      </div>

      <!-- MEUS PEDIDOS TAB -->
      <div id="tab-meus-pedidos" class="tab-content">
        <div class="my-orders-header">
          <h1>Meus Pedidos</h1>
          <p>Histórico de compras</p>
        </div>
        <div id="meus-pedidos-list" style="padding:12px 16px"></div>
      </div>

      <!-- MAPA TAB -->
      <div id="tab-mapa" class="tab-content">
        <div class="mapa-search">
          <div class="mapa-search-inner">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" placeholder="Buscar lojas ou entregadores..." oninput="filterMapaAll(this.value)" />
          </div>
        </div>
        <div class="mapa-filter-bar">
          <button class="mapa-pill active" id="mpill-tudo" onclick="setMapaFilter('tudo',this)">Tudo</button>
          <button class="mapa-pill" id="mpill-lojas" onclick="setMapaFilter('lojas',this)">🏪 <span id="mpill-lojas-count">0</span> lojas</button>
          <button class="mapa-pill" id="mpill-motoboys" onclick="setMapaFilter('motoboys',this)">🛵 <span id="mpill-motoboys-count">0</span> entregadores</button>
        </div>
        <div id="map"></div>
        <div class="nearby-header">
          <span class="nearby-title" id="mapa-nearby-title">Lojas Perto de Você</span>
          <span class="nearby-count" id="mapa-count">0</span>
          <button onclick="addMapMarkers();renderMapAll();" style="background:none;border:none;font-size:18px;cursor:pointer;padding:4px 8px;color:#FF6B00" title="Atualizar mapa">🔄</button>
        </div>
        <div id="mapa-empty" class="empty-state" style="padding-top:0"><p>Nenhum resultado no mapa</p></div>
        <div id="mapa-list" class="lojas-list" style="display:none;padding-top:0"></div>
      </div>

      <!-- CHAT TAB -->
      <div id="tab-chat" class="tab-content">
        <!-- Lista de conversas -->
        <div id="chat-list-view" style="display:flex;flex-direction:column;flex:1;overflow-y:auto">
          <div class="chat-page-header">
            <div class="chat-page-title">💬 Mensagens</div>
            <div class="chat-page-sub">Converse com lojas e suporte</div>
          </div>
          <div class="chat-section-label" style="margin-top:14px">SUPORTE</div>
          <div class="chat-list" style="padding-top:10px">
            <div class="chat-conv-card" onclick="openChat('support')">
              <div class="chat-conv-avatar" style="background:linear-gradient(135deg,#FF9A00,#FF5000);color:#fff;font-size:22px">🤖</div>
              <div class="chat-conv-info">
                <div class="chat-conv-name">Suporte LocalFlow</div>
                <div class="chat-conv-last" id="support-last-msg">Olá! Como posso te ajudar?</div>
              </div>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
                <div class="chat-conv-time" id="support-last-time"></div>
                <div class="chat-unread" id="support-unread" style="display:none">1</div>
              </div>
            </div>
          </div>
          <div class="chat-section-label">LOJAS</div>
          <div class="chat-list" id="stores-chat-list" style="padding-top:10px">
            <div style="text-align:center;padding:24px;color:#bbb;font-size:13px">
              Faça um pedido para iniciar<br>uma conversa com uma loja
            </div>
          </div>
          <div class="chat-section-label">ENTREGADORES</div>
          <div class="chat-list" id="motoboys-chat-list" style="padding-top:10px">
            <div style="text-align:center;padding:24px;color:#bbb;font-size:13px">
              Nenhum entregador online
            </div>
          </div>
        </div>
        <!-- Tela de chat aberto -->
        <div id="chat-open-view" class="chat-screen">
          <div class="chat-screen-header">
            <button class="chat-back-btn" onclick="closeChat()">←</button>
            <div class="chat-screen-avatar" id="chat-open-avatar">🤖</div>
            <div>
              <div class="chat-screen-name" id="chat-open-name">Suporte</div>
              <div class="chat-screen-status">● Online</div>
            </div>
          </div>
          <div class="chat-messages" id="chat-messages"></div>
          <div class="chat-quick" id="chat-quick-row"></div>
          <div class="chat-input-bar">
            <input class="chat-input" id="chat-input" type="text" placeholder="Digite uma mensagem..." onkeydown="chatKey(event)" />
            <button class="chat-send-btn" onclick="chatSend()">➤</button>
          </div>
        </div>
      </div>

      <!-- PERFIL TAB -->
      <div id="tab-perfil" class="tab-content">
        <div class="perfil-wrap">
          <div class="perfil-header">
            <div class="perfil-user">
              <div class="perfil-avatar">👤</div>
              <div>
                <div class="perfil-name" id="perfil-nome">—</div>
                <div class="perfil-email" id="perfil-email">—</div>
                <div class="role-badge" id="perfil-role">Cliente</div>
              </div>
            </div>
            <button class="btn-logout" onclick="doLogout()">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </button>
          </div>

          <!-- Mercantil Toggle -->
          <div class="card">
            <div class="mercantil-row">
              <div class="mercantil-left">
                <div class="merc-icon" id="merc-icon">🏪</div>
                <div>
                  <div class="merc-title">Perfil Mercantil</div>
                  <div class="merc-sub" id="merc-sub-text">Ative para criar sua loja</div>
                </div>
              </div>
              <div class="toggle-track" id="merc-toggle" onclick="toggleMercantil()"></div>
            </div>
          </div>

          <!-- Client card -->
          <div class="card client-card" id="client-card">
            <div style="font-size:48px;margin-bottom:12px">🛒</div>
            <div style="font-size:17px;font-weight:700;color:#111;margin-bottom:8px">Modo Cliente</div>
            <div style="font-size:13px;color:#aaa;text-align:center;line-height:1.5;margin-bottom:20px">Explore lojas, compre produtos e deixe avaliações!</div>
            <button style="border:1.5px solid #e5e7eb;border-radius:14px;padding:10px 24px;background:#fff;font-size:13px;font-weight:500;color:#374151;cursor:pointer;font-family:'Inter',sans-serif" onclick="switchTab('lojas')">Explorar Lojas</button>
          </div>

          <!-- Merchant card -->
          <div class="card" id="merchant-card" style="display:none">
            <div class="card-header">
              <div class="card-icon">🏪</div>
              <div class="card-title" id="merchant-card-title">Minha Loja</div>
            </div>
            <button class="btn-configurar" id="btn-gerenciar-loja" onclick="goMerchantDash()">Gerenciar Loja →</button>
            <div id="btn-criar-loja-wrap" style="display:none;margin-top:8px">
              <button class="btn-configurar" onclick="switchTab('criar-loja')">Criar minha loja</button>
            </div>
          </div>

          <!-- Motoboy Toggle -->
          <div class="card" id="motoboy-toggle-card">
            <div class="mercantil-row">
              <div class="mercantil-left">
                <div class="merc-icon" id="motoboy-icon" style="background:#f3f4f6">🛵</div>
                <div>
                  <div class="merc-title">Perfil Motoboy</div>
                  <div class="merc-sub" id="motoboy-sub-text">Ative para trabalhar como entregador</div>
                </div>
              </div>
              <div class="toggle-track" id="motoboy-toggle" onclick="toggleMotoboy()"></div>
            </div>
          </div>

          <!-- Motoboy card (quando ativo) -->
          <div class="motoboy-profile-card" id="motoboy-profile-card" style="display:none">
            <div class="card-header">
              <div class="card-icon" style="background:linear-gradient(135deg,#22c55e,#16a34a)">🛵</div>
              <div class="card-title">Modo Motoboy</div>
            </div>
            <p style="font-size:13px;color:#6b7280;margin-bottom:10px">Compartilhe sua localização para aparecer no mapa e receber pedidos de entrega.</p>
            <button class="motoboy-gps-btn" id="motoboy-gps-btn" onclick="toggleMotoboyOnline()">
              📍 <span id="motoboy-gps-text">Ficar Online no Mapa</span>
            </button>
            <div id="motoboy-gps-addr" style="font-size:11px;color:#aaa;margin-top:6px;padding:0 4px;text-align:center"></div>
          </div>

          <!-- Meus pedidos button -->
          <div class="card" style="display:flex;align-items:center;justify-content:space-between;cursor:pointer" onclick="switchTab('meus-pedidos')">
            <div style="display:flex;align-items:center;gap:10px">
              <div style="width:36px;height:36px;border-radius:10px;background:#f3f4f6;display:flex;align-items:center;justify-content:center;font-size:18px">📋</div>
              <div>
                <div style="font-size:14px;font-weight:600;color:#111">Meus Pedidos</div>
                <div style="font-size:12px;color:#aaa">Ver histórico</div>
              </div>
            </div>
            <svg width="16" height="16" fill="none" stroke="#d1d5db" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </div>

          <div style="text-align:center;margin-top:8px">
            <p style="font-size:11px;color:#d1d5db">LocalFlow v2.0 · Pagamento na entrega</p>
          </div>
        </div>
      </div>

      <!-- CRIAR LOJA TAB -->
      <div id="tab-criar-loja" class="tab-content">
        <div class="criar-loja-wrap">
          <div class="criar-loja-card">
            <div class="card-header" style="margin-bottom:16px">
              <div class="card-icon">🏪</div>
              <div class="card-title">Criar Loja</div>
            </div>
            <div class="error-msg" id="loja-error"></div>

            <div class="field-group">
              <label class="field-label">Foto da Loja</label>
              <label class="upload-area" id="logo-area">
                <svg id="upload-icon" width="20" height="20" fill="none" stroke="#bbb" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                <span id="upload-label">Adicionar foto</span>
                <img id="logo-preview" class="upload-preview" style="display:none" />
                <input type="file" id="logo-upload" accept="image/*" style="display:none" onchange="handleLogo(this,'logo-preview','upload-label','logo-icon')" />
              </label>
            </div>
            <div class="field-group">
              <label class="field-label">Nome da Loja *</label>
              <input type="text" class="field-input" id="loja-nome" placeholder="Ex: Açaí do João" />
            </div>
            <div class="field-group">
              <label class="field-label">Descrição</label>
              <textarea class="field-input" id="loja-desc" rows="3" placeholder="Descreva sua loja..."></textarea>
            </div>
            <div class="field-group">
              <label class="field-label">Categoria</label>
              <div class="select-wrap">
                <select class="field-input" id="loja-cat" style="padding-right:36px">
                  <option value="outros">📦 Outros</option>
                  <option value="restaurante">🍔 Restaurante</option>
                  <option value="mercado">🛒 Mercado</option>
                  <option value="farmacia">💊 Farmácia</option>
                  <option value="pet">🐾 Pet</option>
                  <option value="Hortifruti">🥦 Hortifruti</option>
                  <option value="Açougue">🥩 Açougue</option>
                  <option value="Frios & Laticínios">🧀 Frios & Laticínios</option>
                </select>
                <span class="select-arrow"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></span>
              </div>
            </div>
            <div class="delivery-box">
              <h4>🛵 Configurar Entrega</h4>
              <div class="grid2">
                <div>
                  <label class="field-label" style="font-size:12px">Taxa de entrega (R$)</label>
                  <input type="number" class="field-input" id="loja-fee" min="0" step="0.01" placeholder="0,00" />
                </div>
                <div>
                  <label class="field-label" style="font-size:12px">Raio de entrega</label>
                  <input type="text" class="field-input" id="loja-radius" placeholder="Ex: 5km, Centro" />
                </div>
              </div>
              <div class="field-note" style="margin-top:8px">💵 Pagamento sempre na porta (dinheiro/pix)</div>
            </div>
            <div class="field-group">
              <label class="field-label">Localização</label>
              <button class="btn-location" onclick="getGPS()">
                📍 <span id="gps-text">Usar minha localização</span>
              </button>
              <div id="gps-addr" style="font-size:11px;color:#aaa;margin-top:6px;padding:0 4px"></div>
            </div>
            <button class="btn-criar" onclick="criarLoja()" id="btn-criar">Criar Loja</button>
          </div>
        </div>
      </div>

      <!-- MERCHANT DASHBOARD TAB -->
      <div id="tab-minha-loja" class="tab-content">
        <div class="dash-header">
          <div style="font-size:11px;color:rgba(255,255,255,0.8);margin-bottom:2px">Painel do Lojista</div>
          <div class="dash-title" id="dash-store-name">Minha Loja</div>
          <div class="dash-badges">
            <span class="dash-badge" id="dash-products-count">0 produtos</span>
            <span class="dash-badge alert" id="dash-pending-orders" style="display:none"></span>
          </div>
        </div>
        <div class="dash-tabs">
          <button class="dash-tab active" onclick="switchDashTab('produtos')">Produtos</button>
          <button class="dash-tab" onclick="switchDashTab('pedidos')" id="dash-tab-pedidos">Pedidos</button>
          <button class="dash-tab" onclick="switchDashTab('loja')">Minha Loja</button>
        </div>
        <div class="dash-content" id="dash-content"></div>
      </div>

    </div>

    <!-- Tab Bar -->
    <div class="tab-bar">
      <button class="tab-item active" id="tab-btn-lojas" onclick="switchTab('lojas')">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline stroke-linecap="round" stroke-linejoin="round" points="9 22 9 12 15 12 15 22"/></svg>
        <span>Lojas</span>
      </button>
      <button class="tab-item" id="tab-btn-mapa" onclick="switchTab('mapa')">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span>Mapa</span>
      </button>
      <button class="tab-item" id="tab-btn-chat" onclick="switchTab('chat')">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        <span>Chat</span>
      </button>
      <button class="tab-item" id="tab-btn-perfil" onclick="switchTab('perfil')">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <span>Perfil</span>
      </button>
    </div>
  </div>

</div>

<!-- Cart Modal -->
<div class="modal-overlay" id="cart-modal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title">Seu pedido</div>
    <div id="cart-items-html"></div>
    <div class="divider"></div>
    <div id="cart-summary-html"></div>
    <p class="payment-note">💵 Pagamento na entrega (dinheiro ou pix)</p>
    <div class="field-group" style="margin-bottom:12px">
      <label class="field-label">Endereço de entrega *</label>
      <input type="text" class="field-input" id="cart-address" placeholder="Rua, número, bairro..." />
    </div>
    <div class="field-group" style="margin-bottom:0">
      <label class="field-label">Observações (opcional)</label>
      <textarea class="field-input" id="cart-notes" rows="2" placeholder="Sem cebola, portão azul..."></textarea>
    </div>
    <div class="error-msg" id="cart-error" style="margin-top:10px"></div>
    <button class="btn-confirm" id="btn-confirmar" onclick="confirmarPedido()">Confirmar pedido</button>
    <button class="btn-ghost" onclick="closeCart()">Continuar comprando</button>
  </div>
</div>

<!-- Review Modal -->
<div class="modal-overlay" id="review-modal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title">Avaliar loja</div>
    <div id="review-store-name" style="font-size:14px;color:#6b7280;margin-bottom:8px"></div>
    <div class="star-row" id="star-row">
      <button class="star-btn" onclick="setStar(1)">⭐</button>
      <button class="star-btn" onclick="setStar(2)">⭐</button>
      <button class="star-btn" onclick="setStar(3)">⭐</button>
      <button class="star-btn" onclick="setStar(4)">⭐</button>
      <button class="star-btn" onclick="setStar(5)">⭐</button>
    </div>
    <div class="field-group" style="margin-top:8px">
      <label class="field-label">Comentário (opcional)</label>
      <textarea class="field-input" id="review-comment" rows="3" placeholder="Como foi sua experiência?"></textarea>
    </div>
    <button class="btn-confirm" onclick="submitReview()">Enviar avaliação</button>
    <button class="btn-ghost" onclick="closeModal('review-modal')">Pular</button>
  </div>
</div>

<!-- Product Form Modal -->
<div class="modal-overlay" id="product-modal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title" id="product-modal-title">Novo Produto</div>
    <div class="error-msg" id="product-error"></div>
    <div class="field-group">
      <label class="field-label">Foto do produto</label>
      <label class="upload-area">
        <div id="prod-upload-preview-wrap">
          <svg width="20" height="20" fill="none" stroke="#bbb" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        </div>
        <span id="prod-upload-label">Adicionar foto</span>
        <img id="prod-img-preview" class="form-upload-preview" style="display:none" />
        <input type="file" id="prod-img-input" accept="image/*" style="display:none" onchange="handleLogo(this,'prod-img-preview','prod-upload-label')" />
      </label>
    </div>
    <div class="field-group">
      <label class="field-label">Nome do produto *</label>
      <input type="text" class="field-input" id="prod-name" placeholder="Ex: X-Burguer" />
    </div>
    <div class="field-group">
      <label class="field-label">Descrição</label>
      <textarea class="field-input" id="prod-desc" rows="2" placeholder="Descreva o produto..."></textarea>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
      <div>
        <label class="field-label">Preço (R$) *</label>
        <input type="number" class="field-input" id="prod-price" min="0" step="0.01" placeholder="0,00" />
      </div>
      <div>
        <label class="field-label">Estoque *</label>
        <input type="number" class="field-input" id="prod-stock" min="0" step="1" placeholder="0" />
      </div>
    </div>
    <div class="field-group">
      <label class="field-label">Taxa de entrega do produto (R$)</label>
      <input type="number" class="field-input" id="prod-fee" min="0" step="0.01" placeholder="0,00" />
      <div class="field-note">Deixe 0 para usar a taxa padrão da loja</div>
    </div>
    <button class="btn-confirm" id="btn-save-product" onclick="saveProduct()">Criar produto</button>
    <button class="btn-ghost" onclick="closeModal('product-modal')">Cancelar</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- ===== RIDE REQUEST MODAL ===== -->
<div class="ride-modal-overlay" id="ride-modal">
  <div class="ride-modal-sheet">
    <div class="ride-modal-handle"></div>
    <div class="ride-modal-moto">
      <div class="ride-modal-avatar">🛵</div>
      <div>
        <div class="ride-modal-name" id="ride-moto-name">Entregador</div>
        <div class="ride-modal-sub">● Online agora · Disponível</div>
      </div>
    </div>
    <div class="ride-price-row">
      <div>
        <div class="ride-price-label">💰 Valor estimado</div>
        <div style="font-size:11px;color:#6b7280;margin-top:2px">Calculado pela distância</div>
      </div>
      <div class="ride-price-val" id="ride-price-val">R$ 8,00</div>
    </div>
    <input class="ride-dest-input" id="ride-dest" placeholder="📍 Para onde? Ex: Rua das Flores, 123" />
    <div class="error-msg" id="ride-error" style="margin-bottom:10px"></div>
    <button class="btn-pedir-corrida" onclick="submitRideRequest()">🛵 Pedir Corrida</button>
    <button class="btn-ghost" onclick="closeRideModal()" style="margin-top:10px;width:100%">Cancelar</button>
  </div>
</div>

<!-- ===== MOTOBOY RIDE NOTIFICATION BANNER ===== -->
<div id="motoboy-ride-banner">
  <div class="ride-banner-inner">
    <div class="ride-banner-top">
      <div class="ride-banner-icon">🛵</div>
      <div>
        <div class="ride-banner-title">Nova Corrida!</div>
        <div class="ride-banner-sub" id="banner-requester">Cliente solicitou</div>
      </div>
    </div>
    <div class="ride-banner-body">
      <div class="ride-banner-dest" id="banner-dest">Destino: —</div>
      <div class="ride-banner-price" id="banner-price">R$ 0,00</div>
      <div class="ride-banner-btns">
        <button class="btn-aceitar" onclick="acceptRide()">✅ Aceitar</button>
        <button class="btn-recusar" onclick="rejectRide()">❌ Recusar</button>
      </div>
    </div>
  </div>
</div>

<!-- ===== ROUTE PANEL ===== -->
<div id="route-panel">
  <div class="route-panel-header">
    <div class="route-panel-title">🗺️ Rota GPS ativa</div>
    <button class="route-panel-close" onclick="closeRoute()">✕</button>
  </div>
  <div class="route-step" id="route-dest-label">Destino: —</div>
  <div class="route-step" id="route-dist-label" style="color:#FF6B00;margin-top:4px"></div>
  <button class="btn-entreguei" onclick="finishRide()">✅ Entrega concluída</button>
</div>

<script>
// ===== API BASE (shared server) =====
const API = '/api/localflow';
async function apiFetch(path, opts={}) {
  try {
    const r = await fetch(API+path, { headers:{'Content-Type':'application/json'}, ...opts });
    return r.ok ? await r.json() : null;
  } catch(e) { return null; }
}

// ===== DATA LAYER (localStorage) =====
const ADMIN_EMAIL = 'huagnermarques@gmail.com';
const DB = {
  get: (k) => JSON.parse(localStorage.getItem('lf_'+k) || 'null'),
  set: (k, v) => localStorage.setItem('lf_'+k, JSON.stringify(v)),
  users:    () => DB.get('users')    || [],
  stores:   () => DB.get('stores')   || [],
  products: () => DB.get('products') || [],
  orders:   () => DB.get('orders')   || [],
  reviews:  () => DB.get('reviews')  || [],
  motoboys: () => DB.get('motoboys') || [],
  rides:    () => DB.get('rides')    || [],
  session:  () => DB.get('session'),
  saveUsers:    (v) => DB.set('users',v),
  saveStores:   (v) => DB.set('stores',v),
  saveProducts: (v) => DB.set('products',v),
  saveOrders:   (v) => DB.set('orders',v),
  saveReviews:  (v) => DB.set('reviews',v),
  saveMotoboys: (v) => DB.set('motoboys',v),
  saveRides:    (v) => DB.set('rides',v),
  saveSession:  (v) => DB.set('session',v),
  nextId: (arr) => arr.length ? Math.max(...arr.map(x=>x.id))+1 : 1,
};

// ===== STATE =====
let currentUser = null;
let currentCat = 'todas';
let currentSearch = '';
let cart = [];
let currentStoreId = null;
let mapInitialized = false;
let leafletMap = null;
let gpsCoords = null;
let logoDataUrl = null;
let mercantilOn = false;
let motoboyOn = false;
let motoboyIsOnline = false;
let currentDashTab = 'produtos';
let editingProductId = null;
let reviewOrderId = null;
let reviewStoreId = null;
let reviewStarVal = 0;
let mapaFilter = 'tudo';
let mapaSearchQ = '';

const catEmojis = { outros:'📦', restaurante:'🍔', mercado:'🛒', farmacia:'💊', pet:'🐾' };
const statusColors = { pendente:'#f59e0b', confirmado:'#3b82f6', em_entrega:'#8b5cf6', entregue:'#10b981', cancelado:'#ef4444' };
const statusLabels = { pendente:'Pendente', confirmado:'Confirmado', em_entrega:'Em entrega', entregue:'Entregue', cancelado:'Cancelado' };
const nextStatus = { pendente:'confirmado', confirmado:'em_entrega', em_entrega:'entregue' };
const nextStatusLabel = { pendente:'Confirmar', confirmado:'Saiu p/ entrega', em_entrega:'Marcar entregue' };

function fmt(v) { return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}); }
function starsHtml(r,size=14) { let s=''; for(let i=1;i<=5;i++) s+=`<span style="color:${i<=Math.round(r)?'#FF6B00':'#e5e7eb'};font-size:${size}px">★</span>`; return s; }
  
// ===== NAVIGATION =====
function showPage(id) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

const tabBtns = ['lojas','mapa','chat','perfil'];
let _currentTab = '';
function switchTab(tab) {
  _currentTab = tab;
  document.querySelectorAll('.tab-content').forEach(tc=>tc.classList.remove('active'));
  document.querySelectorAll('.tab-item').forEach(tb=>tb.classList.remove('active'));
  const el = document.getElementById('tab-'+tab);
  if (el) el.classList.add('active');
  const btn = document.getElementById('tab-btn-'+tab);
  if (btn) btn.classList.add('active');
  if (tab==='mapa') {
    if (!mapInitialized) initMap();
    else { addMapMarkers(); renderMapAll(); } // refresh every time
  }
  if (tab==='chat') renderChatList();
  if (tab==='meus-pedidos') renderMeusPedidos();
  if (tab==='perfil') renderPerfil();
  if (tab==='minha-loja') renderDash();
}

// ===== AUTH =====
let loginMode = 'login';
function setLoginMode(m) {
  loginMode = m;
  document.getElementById('field-name').style.display = m==='register' ? 'block' : 'none';
  document.getElementById('btn-login').textContent = m==='register' ? 'Cadastrar' : 'Entrar';
  document.getElementById('login-sub-text').textContent = m==='register' ? 'Crie sua conta gratuita' : 'Entre na sua conta';
  document.querySelectorAll('.login-tab').forEach((t,i)=>{ t.classList.toggle('active', (i===0&&m==='login')||(i===1&&m==='register')); });
  hideErr('login-error');
}

function doLogin() {
  const email = document.getElementById('input-email').value.trim();
  const pass = document.getElementById('input-password').value;
  if (!email||!pass) { showErr('login-error','Preencha todos os campos.'); return; }
  if (loginMode==='register') {
    const name = document.getElementById('input-name').value.trim();
    if (!name) { showErr('login-error','Informe seu nome.'); return; }
    const users = DB.users();
    if (users.find(u=>u.email===email)) { showErr('login-error','E-mail já cadastrado.'); return; }
    const user = { id: DB.nextId(users), name, email, password: pass, isMerchant: false, isAdmin: email===ADMIN_EMAIL };
    users.push(user);
    DB.saveUsers(users);
    DB.saveSession(user.id);
    currentUser = user;
  } else {
    const users = DB.users();
    let user = users.find(u=>u.email===email && u.password===pass);
    if (!user) { showErr('login-error','E-mail ou senha incorretos.'); return; }
    // Guarantee admin flag on known admin email
    if (email===ADMIN_EMAIL && !user.isAdmin) {
      user.isAdmin = true;
      DB.saveUsers(users);
    }
    DB.saveSession(user.id);
    currentUser = user;
  }
  enterApp();
}

function doLogout() {
  DB.saveSession(null);
  currentUser = null;
  cart = [];
  showPage('page-login');
}

function enterApp() {
  mercantilOn = currentUser.isMerchant || false;
  motoboyOn = currentUser.isMotoboy || false;
  showPage('page-app');
  switchTab('lojas');
  document.getElementById('lojas-greeting').textContent = getGreeting() + ' ' + currentUser.name.split(' ')[0] + '!';
  renderLojas();
  renderPerfil();
}

// ===== GREETING & AO VIVO =====
function getGreeting() {
  const h = new Date().getHours();
  if (h >= 5 && h < 12) return '☀️ BOM DIA!';
  if (h >= 12 && h < 18) return '🌤️ BOA TARDE!';
  return '🌙 BOA NOITE!';
}

function updateAoVivo() {
  const lEl = document.getElementById('aovivo-lojas');
  const mEl = document.getElementById('aovivo-motoboys');
  if (lEl) lEl.textContent = DB.stores().length;
  if (mEl) mEl.textContent = DB.motoboys().filter(mb=>mb.isOnline).length;
}

// ===== QUICK FILTER STATE =====
let activeQuickFilters = new Set();

function toggleQuickFilter(id, btn) {
  if (activeQuickFilters.has(id)) { activeQuickFilters.delete(id); btn.classList.remove('active'); }
  else { activeQuickFilters.add(id); btn.classList.add('active'); }
  renderLojas();
}

function selectIconCat(btn, cat) {
  document.querySelectorAll('.icon-cat').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  currentCat = cat;
  // sync top pills
  document.querySelectorAll('.cat-pill').forEach(p=>p.classList.remove('active'));
  const matchPill = Array.from(document.querySelectorAll('.cat-pill')).find(p=>p.getAttribute('onclick')&&p.getAttribute('onclick').includes(`'${cat}'`));
  if (matchPill) matchPill.classList.add('active');
  loadLojas();
}

// ===== RENDER LOJAS =====
function renderLojas() {
  updateAoVivo();
  let stores = DB.stores();
  if (currentCat !== 'todas') stores = stores.filter(s => s.categoria === currentCat);
  if (currentSearch) stores = stores.filter(s => s.nome.toLowerCase().includes(currentSearch.toLowerCase()) || (s.descricao||'').toLowerCase().includes(currentSearch.toLowerCase()));
  if (activeQuickFilters.has('avaliadas')) stores = stores.filter(s => DB.reviews().some(r=>r.storeId===s.id));
  if (activeQuickFilters.has('rastreio')) stores = stores.filter(s => s.lat && s.lng);

  const list = document.getElementById('lojas-list');
  const empty = document.getElementById('lojas-empty');
  const countRow = document.getElementById('lojas-count-row');
  document.getElementById('lojas-loading').style.display = 'none';

  if (!stores.length) {
    list.style.display = 'none';
    if (countRow) { countRow.style.display = 'none'; }
    empty.style.display = 'flex';
    return;
  }
  empty.style.display = 'none';
  list.style.display = 'grid';
  if (countRow) { countRow.style.display = 'block'; countRow.textContent = stores.length + (stores.length===1?' loja encontrada':' lojas encontradas'); }

  list.innerHTML = stores.map(s => {
    const reviews = DB.reviews().filter(r => r.storeId === s.id);
    const avg = reviews.length ? reviews.reduce((a,r)=>a+r.rating,0)/reviews.length : 0;
    const fee = Number(s.deliveryFee||0);
    const ratingHtml = avg > 0
      ? `<span class="loja-rating-tag">⭐ ${avg.toFixed(1)}</span>`
      : `<span class="loja-rating-tag">⭐ Novo</span>`;
    const deliveryHtml = fee > 0
      ? `<span class="loja-delivery-tag">🚗 ${fmt(fee)}</span>`
      : `<span class="loja-delivery-tag free">🚗 Grátis</span>`;
    const logoHtml = s.logo
      ? `<img src="${s.logo}" style="width:100%;height:100%;object-fit:cover"/>`
      : (catEmojis[s.categoria]||'🏪');
    return `<div class="loja-grid-card" onclick="openStore(${s.id})">
      <div class="loja-grid-img">${logoHtml}</div>
      <div class="loja-grid-body">
        <div class="loja-grid-name">${s.nome}</div>
        ${s.descricao?`<div class="loja-grid-desc">${s.descricao}</div>`:''}
        <div class="loja-grid-meta">${ratingHtml}${deliveryHtml}</div>
      </div>
    </div>`;
  }).join('');
}

// ===== LOJAS =====
function loadLojas() {
  document.getElementById("lojas-loading").style.display = "block";
  document.getElementById("lojas-list").style.display = "none";
  document.getElementById("lojas-empty").style.display = "none";

  setTimeout(() => {
    document.getElementById("lojas-loading").style.display = "none";
    renderLojas();
  }, 700);
}
  
  function loadLojas() {
  document.getElementById("lojas-loading").style.display = "block";
  document.getElementById("lojas-list").style.display = "none";
  document.getElementById("lojas-empty").style.display = "none";

  setTimeout(() => {
    document.getElementById("lojas-loading").style.display = "none";
    renderLojas();
  }, 700);
}
  
function selectCat(btn, cat) {
  document.querySelectorAll('.cat-pill').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  currentCat = cat;
  // sync icon cats
  document.querySelectorAll('.icon-cat').forEach(b=>b.classList.remove('active'));
  const matchIcon = Array.from(document.querySelectorAll('.icon-cat')).find(b=>b.getAttribute('onclick')&&b.getAttribute('onclick').includes(`'${cat}'`));
  if (matchIcon) matchIcon.classList.add('active');
  loadLojas();
}

function filterLojas() {
  currentSearch = document.getElementById('search-input').value;
  loadLojas();
}

// ===== STORE DETAIL =====
function openStore(storeId) {
  currentStoreId = storeId;
  cart = [];
  const store = DB.stores().find(s=>s.id===storeId);
  if (!store) return;
  switchTab('loja-detail');
  document.getElementById('detail-loading').style.display='flex';
  document.getElementById('detail-content').style.display='none';
  setTimeout(()=>renderStoreDetail(store), 200);
}

function renderStoreDetail(store) {
  const products = DB.products().filter(p=>p.storeId===store.id && p.isActive && p.stock>0);
  const reviews = DB.reviews().filter(r=>r.storeId===store.id);
  const fee = Number(store.deliveryFee||0);
  const html = `
    <div class="detail-header">
      <button class="detail-back" onclick="switchTab('lojas')">← Voltar</button>
      <div class="detail-header-row">
        <div class="detail-logo">${store.logo?`<img src="${store.logo}"/>`:(catEmojis[store.categoria]||'🏪')}</div>
        <div>
          <div class="detail-name">${store.nome}</div>
          <div class="detail-cat">${catEmojis[store.categoria]||'📦'} ${store.categoria}</div>
          ${store.descricao?`<div class="detail-desc">${store.descricao}</div>`:''}
        </div>
      </div>
      <div class="detail-badges">
        <span class="detail-tag">${store.isOpen!==false?'✅ Aberta':'❌ Fechada'}</span>
        <span class="detail-tag">${fee>0?'🛵 Entrega '+fmt(fee):'🛵 Entrega grátis'}</span>
        ${store.deliveryRadius?`<span class="detail-tag">📍 ${store.deliveryRadius}</span>`:''}
        <span class="detail-tag">💵 Paga na entrega</span>
      </div>
    </div>
    <div class="detail-tabs">
      <button class="detail-tab active" id="dtab-produtos" onclick="switchDetailTab('produtos')">Produtos (${products.length})</button>
      <button class="detail-tab" id="dtab-avaliacoes" onclick="switchDetailTab('avaliacoes')">Avaliações (${reviews.length})</button>
    </div>
    <div id="dtab-content-produtos" class="products-section">
      ${!products.length
        ? '<div class="empty-state"><div class="empty-icon">📭</div><p>Sem produtos disponíveis</p></div>'
        : products.map(p=>productCardHtml(p)).join('')
      }
    </div>
    <div id="dtab-content-avaliacoes" class="products-section" style="display:none">
      ${!reviews.length
        ? '<div class="empty-state"><div class="empty-icon">💬</div><p>Sem avaliações ainda</p></div>'
        : reviews.map(r=>`<div class="product-card" style="padding:14px 16px">
            <div style="font-weight:700;font-size:14px;margin-bottom:4px">${'⭐'.repeat(r.rating)} ${r.rating.toFixed(1)}</div>
            ${r.comment?`<div style="font-size:13px;color:#6b7280">${r.comment}</div>`:''}
            <div style="font-size:11px;color:#bbb;margin-top:6px">${new Date(r.createdAt).toLocaleDateString('pt-BR')}</div>
          </div>`).join('')
      }
    </div>
    <div style="height:80px"></div>
  `;
  document.getElementById('detail-loading').style.display='none';
  document.getElementById('detail-content').style.display='block';
  document.getElementById('detail-content').innerHTML = html;
  updateCartFab();
}

function switchDetailTab(tab) {
  document.querySelectorAll('.detail-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('dtab-'+tab).classList.add('active');
  document.getElementById('dtab-content-produtos').style.display = tab==='produtos' ? 'block' : 'none';
  document.getElementById('dtab-content-avaliacoes').style.display = tab==='avaliacoes' ? 'block' : 'none';
}

function productCardHtml(p) {
  const item = cart.find(i=>i.product.id===p.id);
  const qty = item ? item.qty : 0;
  return `<div class="product-card" id="pcard-${p.id}">
    <div class="product-row">
      <div class="product-img">${p.imageUrl?`<img src="${p.imageUrl}"/>`:'🛍️'}</div>
      <div class="product-info">
        <div class="product-name">${p.name}</div>
        ${p.description?`<div class="product-desc">${p.description}</div>`:''}
        <div class="product-price">${fmt(p.price)}</div>
        <div class="product-stock">Estoque: ${p.stock}</div>
      </div>
    </div>
    <div class="product-controls">
      ${qty===0
        ? `<button class="btn-add" onclick="addToCart(${p.id})">+ Adicionar</button><span></span>`
        : `<div class="qty-controls">
            <button class="qty-btn" onclick="changeQty(${p.id},-1)">−</button>
            <span class="qty-num">${qty}</span>
            <button class="qty-btn plus" onclick="changeQty(${p.id},1)" ${qty>=p.stock?'disabled':''}>+</button>
          </div>
          <span class="qty-total">${fmt(Number(p.price)*qty)}</span>`
      }
    </div>
  </div>`;
}

function addToCart(pid) {
  const p = DB.products().find(x=>x.id===pid);
  if (!p) return;
  const idx = cart.findIndex(i=>i.product.id===pid);
  if (idx===-1) cart.push({product:p, qty:1});
  else cart[idx].qty++;
  refreshProductCard(pid);
  updateCartFab();
}

function changeQty(pid, delta) {
  const idx = cart.findIndex(i=>i.product.id===pid);
  if (idx===-1) return;
  cart[idx].qty += delta;
  if (cart[idx].qty <= 0) cart.splice(idx,1);
  refreshProductCard(pid);
  updateCartFab();
}

function refreshProductCard(pid) {
  const p = DB.products().find(x=>x.id===pid);
  const card = document.getElementById('pcard-'+pid);
  if (!card || !p) return;
  card.outerHTML = productCardHtml(p);
}

function updateCartFab() {
  let fab = document.getElementById('cart-fab');
  const count = cart.reduce((s,i)=>s+i.qty,0);
  const subtotal = cart.reduce((s,i)=>s+Number(i.product.price)*i.qty,0);
  if (count===0) { if(fab) fab.remove(); return; }
  if (!fab) {
    fab = document.createElement('div');
    fab.id = 'cart-fab';
    fab.className = 'cart-fab';
    document.getElementById('app').appendChild(fab);
  }
  fab.innerHTML = `<button class="cart-btn" onclick="openCart()">
    <span class="cart-count-badge">${count}</span>
    <span>Ver carrinho</span>
    <span>${fmt(subtotal)}</span>
  </button>`;
}

function openCart() {
  const store = DB.stores().find(s=>s.id===currentStoreId);
  const fee = Number(store?.deliveryFee||0);
  const subtotal = cart.reduce((s,i)=>s+Number(i.product.price)*i.qty,0);
  const total = subtotal+fee;
  let itemsHtml = cart.map(i=>`
    <div class="cart-item-row">
      <div>
        <div class="cart-item-name">${i.product.name}</div>
        <div class="cart-qty-mini">
          <button onclick="cartChangeQty(${i.product.id},-1)" style="border-color:#e5e7eb;color:#374151">−</button>
          <span style="font-size:13px;font-weight:700">${i.qty}</span>
          <button class="cq-plus" onclick="cartChangeQty(${i.product.id},1)">+</button>
        </div>
      </div>
      <div class="cart-item-price">${fmt(Number(i.product.price)*i.qty)}</div>
    </div>`).join('');
  document.getElementById('cart-items-html').innerHTML = itemsHtml;
  document.getElementById('cart-summary-html').innerHTML = `
    <div class="summary-row"><span>Subtotal</span><span>${fmt(subtotal)}</span></div>
    <div class="summary-row"><span>Taxa de entrega</span><span>${fee>0?fmt(fee):'Grátis'}</span></div>
    <div class="summary-total"><span>Total</span><span>${fmt(total)}</span></div>`;
  document.getElementById('btn-confirmar').textContent = `Confirmar pedido · ${fmt(total)}`;
  hideErr('cart-error');
  document.getElementById('cart-address').value='';
  document.getElementById('cart-notes').value='';
  document.getElementById('cart-modal').classList.add('open');
}

function cartChangeQty(pid, delta) {
  changeQty(pid, delta);
  if (cart.length===0) { closeCart(); return; }
  openCart();
}

function closeCart() { document.getElementById('cart-modal').classList.remove('open'); }

function confirmarPedido() {
  const addr = document.getElementById('cart-address').value.trim();
  if (!addr) { showErr('cart-error','Informe o endereço de entrega.'); return; }
  const store = DB.stores().find(s=>s.id===currentStoreId);
  const fee = Number(store?.deliveryFee||0);
  const subtotal = cart.reduce((s,i)=>s+Number(i.product.price)*i.qty,0);
  const total = subtotal+fee;
  const orders = DB.orders();
  const order = {
    id: DB.nextId(orders),
    storeId: currentStoreId,
    storeName: store.nome,
    userId: currentUser.id,
    userName: currentUser.name,
    status: 'pendente',
    total: total,
    deliveryFee: fee,
    deliveryAddress: addr,
    notes: document.getElementById('cart-notes').value.trim()||null,
    items: cart.map(i=>({ productId:i.product.id, name:i.product.name, qty:i.qty, unitPrice:Number(i.product.price) })),
    createdAt: new Date().toISOString(),
  };
  orders.push(order);
  DB.saveOrders(orders);
  // Decrement stock
  const products = DB.products();
  cart.forEach(i=>{ const p=products.find(x=>x.id===i.product.id); if(p) p.stock-=i.qty; });
  DB.saveProducts(products);
  closeCart();
  const fab = document.getElementById('cart-fab');
  if(fab) fab.remove();
  cart=[];
  currentStoreId=null;
  switchTab('order-success');
}

function afterOrder() {
  switchTab('lojas');
  renderLojas();
}
  
// ===== MEUS PEDIDOS =====
function renderMeusPedidos() {
  const myOrders = DB.orders().filter(o=>o.userId===currentUser.id).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
  const div = document.getElementById('meus-pedidos-list');
  if (!myOrders.length) {
    div.innerHTML='<div class="empty-state"><div class="empty-icon">📋</div><p>Nenhum pedido ainda</p></div>';
    return;
  }
  div.innerHTML = myOrders.map(o=>{
    const color = statusColors[o.status]||'#aaa';
    const label = statusLabels[o.status]||o.status;
    const itemsText = o.items.map(i=>`${i.qty}× ${i.name}`).join(', ');
    const canReview = o.status==='entregue' && !DB.reviews().find(r=>r.storeId===o.storeId && r.userId===currentUser.id && r.orderId===o.id);
    return `<div class="my-order-card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px">
        <div class="my-order-store">${o.storeName}</div>
        <span class="my-order-status" style="background:${color}">${label}</span>
      </div>
      <div class="my-order-items">${itemsText}</div>
      <div style="font-size:11px;color:#aaa">📍 ${o.deliveryAddress}</div>
      <div class="my-order-meta">
        <span class="my-order-total">Total: ${fmt(o.total)}</span>
        <span style="font-size:11px;color:#aaa">${new Date(o.createdAt).toLocaleDateString('pt-BR')}</span>
      </div>
      ${canReview?`<button class="btn-review" onclick="openReview(${o.id},${o.storeId},'${o.storeName}')">⭐ Avaliar loja</button>`:''}
    </div>`;
  }).join('');
}

// ===== REVIEW =====
function openReview(orderId, storeId, storeName) {
  reviewOrderId=orderId; reviewStoreId=storeId; reviewStarVal=0;
  document.getElementById('review-store-name').textContent = storeName;
  document.querySelectorAll('.star-btn').forEach(b=>b.classList.remove('selected'));
  document.getElementById('review-comment').value='';
  document.getElementById('review-modal').classList.add('open');
}

function setStar(n) {
  reviewStarVal=n;
  document.querySelectorAll('.star-btn').forEach((b,i)=>b.classList.toggle('selected',i<n));
}

function submitReview() {
  if (!reviewStarVal) { showToast('Selecione uma nota!'); return; }
  const reviews = DB.reviews();
  const existing = reviews.findIndex(r=>r.storeId===reviewStoreId && r.userId===currentUser.id && r.orderId===reviewOrderId);
  const rev = {
    id: existing===-1?DB.nextId(reviews):reviews[existing].id,
    storeId: reviewStoreId, userId: currentUser.id, orderId: reviewOrderId,
    userName: currentUser.name, rating: reviewStarVal,
    comment: document.getElementById('review-comment').value.trim()||null,
    createdAt: new Date().toISOString(),
  };
  if (existing===-1) reviews.push(rev); else reviews[existing]=rev;
  DB.saveReviews(reviews);
  closeModal('review-modal');
  showToast('✅ Avaliação enviada!');
  renderMeusPedidos();
}

// ===== PERFIL =====
function renderPerfil() {
  if (!currentUser) return;
  document.getElementById('perfil-nome').textContent = currentUser.name;
  document.getElementById('perfil-email').textContent = currentUser.email;
  let roleText = '🛒 Cliente';
  if (mercantilOn && motoboyOn) roleText = '🏪 Lojista · 🛵 Motoboy';
  else if (mercantilOn) roleText = '🏪 Lojista';
  else if (motoboyOn) roleText = '🛵 Motoboy';
  const roleEl = document.getElementById('perfil-role');
  roleEl.textContent = roleText;
  if (currentUser.isAdmin) {
    if (!document.getElementById('admin-badge-el')) {
      const badge = document.createElement('span');
      badge.id = 'admin-badge-el';
      badge.className = 'admin-badge';
      badge.innerHTML = '⭐ ADM';
      roleEl.parentNode.insertBefore(badge, roleEl.nextSibling);
    }
  }

  // Merchant toggle
  const toggle = document.getElementById('merc-toggle');
  const icon = document.getElementById('merc-icon');
  const sub = document.getElementById('merc-sub-text');
  toggle.classList.toggle('on', mercantilOn);
  icon.classList.toggle('on', mercantilOn);
  if (mercantilOn) {
    sub.textContent='Modo lojista ativo';
    document.getElementById('client-card').style.display='none';
    document.getElementById('merchant-card').style.display='block';
    const myStore = DB.stores().find(s=>s.ownerId===currentUser.id);
    if (myStore) {
      document.getElementById('merchant-card-title').textContent = myStore.nome;
      document.getElementById('btn-gerenciar-loja').style.display='block';
      document.getElementById('btn-criar-loja-wrap').style.display='none';
    } else {
      document.getElementById('merchant-card-title').textContent = 'Minha Loja';
      document.getElementById('btn-gerenciar-loja').style.display='none';
      document.getElementById('btn-criar-loja-wrap').style.display='block';
    }
  } else {
    sub.textContent='Ative para criar sua loja';
    document.getElementById('client-card').style.display='flex';
    document.getElementById('merchant-card').style.display='none';
  }

  // Motoboy toggle
  const mbToggle = document.getElementById('motoboy-toggle');
  const mbIcon = document.getElementById('motoboy-icon');
  const mbSub = document.getElementById('motoboy-sub-text');
  const mbCard = document.getElementById('motoboy-profile-card');
  if (mbToggle) {
    mbToggle.classList.toggle('on', motoboyOn);
    if (mbIcon) { mbIcon.style.background = motoboyOn ? 'linear-gradient(135deg,#22c55e,#16a34a)' : '#f3f4f6'; }
    if (mbSub) mbSub.textContent = motoboyOn ? 'Modo motoboy ativo' : 'Ative para trabalhar como entregador';
    if (mbCard) mbCard.style.display = motoboyOn ? 'block' : 'none';
    // Sync button state
    const mbBtn = document.getElementById('motoboy-gps-btn');
    const mbTxt = document.getElementById('motoboy-gps-text');
    if (mbBtn && mbTxt) {
      mbBtn.classList.toggle('online', motoboyIsOnline);
      mbTxt.textContent = motoboyIsOnline ? 'Ficar Offline' : 'Ficar Online no Mapa';
    }
  }
}

function toggleMercantil() {
  mercantilOn = !mercantilOn;
  const users = DB.users();
  const idx = users.findIndex(u=>u.id===currentUser.id);
  if (idx!==-1) { users[idx].isMerchant=mercantilOn; DB.saveUsers(users); currentUser=users[idx]; }
  renderPerfil();
}

// ===== MOTOBOY =====
function toggleMotoboy() {
  motoboyOn = !motoboyOn;
  const users = DB.users();
  const idx = users.findIndex(u=>u.id===currentUser.id);
  if (idx!==-1) { users[idx].isMotoboy=motoboyOn; DB.saveUsers(users); currentUser=users[idx]; }
  if (!motoboyOn && motoboyIsOnline) {
    motoboyIsOnline = false;
    const mbs = DB.motoboys();
    const mi = mbs.findIndex(m=>m.userId===currentUser.id);
    if (mi!==-1) { mbs[mi].isOnline=false; DB.saveMotoboys(mbs); }
  }
  renderPerfil();
}

function toggleMotoboyOnline() {
  const btn = document.getElementById('motoboy-gps-btn');
  const txt = document.getElementById('motoboy-gps-text');
  const addr = document.getElementById('motoboy-gps-addr');
  if (motoboyIsOnline) {
    motoboyIsOnline = false;
    // Go offline on server
    apiFetch('/motoboys/'+currentUser.id, { method:'DELETE' });
    btn.classList.remove('online');
    txt.textContent = 'Ficar Online no Mapa';
    addr.textContent = '';
    if (mapInitialized) { addMapMarkers(); updateMapaPills(); }
    showToast('🔴 Você ficou offline');
  } else {
    txt.textContent = 'Obtendo localização...';
    const go = async (lat, lng) => {
      motoboyIsOnline = true;
      // Register on server
      await apiFetch('/motoboys', { method:'POST', body: JSON.stringify({
        userId: currentUser.id, userName: currentUser.name,
        lat: lat||0, lng: lng||0,
      })});
      btn.classList.add('online');
      txt.textContent = 'Ficar Offline';
      if (lat) {
        fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`)
          .then(r=>r.json()).then(j=>{ addr.textContent='📍 '+((j.address?.road||j.display_name||'').substring(0,40)+'...'); }).catch(()=>{});
      }
      if (mapInitialized) { addMapMarkers(); updateMapaPills(); }
      showToast('🟢 Você está online no mapa!');
    };
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(p=>go(p.coords.latitude,p.coords.longitude), ()=>go(0,0));
    } else { go(0,0); }
  }
}

function goMerchantDash() { switchTab('minha-loja'); renderDash(); }

// ===== CRIAR LOJA =====
function handleLogo(input, previewId, labelId) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const preview = document.getElementById(previewId);
    preview.src=e.target.result; preview.style.display='block';
    document.getElementById(labelId).textContent='';
    if (previewId==='logo-preview') logoDataUrl=e.target.result;
    if (previewId==='prod-img-preview') prodImgDataUrl=e.target.result;
  };
  reader.readAsDataURL(file);
}

let prodImgDataUrl = null;

function getGPS() {
  const txt = document.getElementById('gps-text');
  txt.textContent='Obtendo...';
  if (!navigator.geolocation) { txt.textContent='GPS não disponível'; return; }
  navigator.geolocation.getCurrentPosition(async pos=>{
    gpsCoords={lat:pos.coords.latitude, lng:pos.coords.longitude};
    txt.textContent='✅ Localização obtida!';
    try {
      const r = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${gpsCoords.lat}&lon=${gpsCoords.lng}&format=json`);
      const j = await r.json();
      document.getElementById('gps-addr').textContent=j.display_name||'';
    } catch{};
  }, ()=>{ txt.textContent='Não foi possível obter'; });
}

function criarLoja() {
  const nome = document.getElementById('loja-nome').value.trim();
  if (!nome) { showErr('loja-error','Informe o nome da loja.'); return; }
  const stores = DB.stores();
  if (stores.find(s=>s.ownerId===currentUser.id)) { showErr('loja-error','Você já tem uma loja cadastrada.'); return; }
  const store = {
    id: DB.nextId(stores),
    ownerId: currentUser.id,
    nome, logo: logoDataUrl||null,
    descricao: document.getElementById('loja-desc').value.trim()||null,
    categoria: document.getElementById('loja-cat').value,
    deliveryFee: parseFloat(document.getElementById('loja-fee').value)||0,
    deliveryRadius: document.getElementById('loja-radius').value.trim()||null,
    lat: gpsCoords?.lat||null, lng: gpsCoords?.lng||null,
    isOpen: true,
    createdAt: new Date().toISOString(),
  };
  stores.push(store);
  DB.saveStores(stores);
  const users = DB.users();
  const idx = users.findIndex(u=>u.id===currentUser.id);
  if(idx!==-1) { users[idx].isMerchant=true; DB.saveUsers(users); currentUs=users[idx]; }
  mercantilOn=true;
  // reset
  logoDataUrl=null; gpsCoords=null;
  ['loja-nome','loja-desc','loja-fee','loja-radius'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('logo-preview').style.display='none';
  document.getElementById('upload-label').textContent='Adicionar foto';
  document.getElementById('gps-text').textContent='Usar minha localização';
  document.getElementById('gps-addr').textContent='';
  showToast('✅ Loja "'+nome+'" criada!');
  renderLojas();
  if(window._lojaMarkers!==undefined && leafletMap) addMapMarkers();
  switchTab('minha-loja');
  renderDash();
}

// ===== MERCHANT DASHBOARD =====
let currentDashStoreId = null;

function renderDash() {
  const store = DB.stores().find(s=>s.ownerId===currentUser.id);
  if (!store) {
    document.getElementById('dash-store-name').textContent='Nenhuma loja';
    document.getElementById('dash-content').innerHTML='<div class="empty-state"><div class="empty-icon">🏪</div><p>Crie sua loja primeiro</p></div>';
    return;
  }
  currentDashStoreId = store.id;
  document.getElementById('dash-store-name').textContent=store.nome;
  const products = DB.products().filter(p=>p.storeId===store.id);
  document.getElementById('dash-products-count').textContent=products.length+' produto'+(products.length!==1?'s':'');
  const pending = DB.orders().filter(o=>o.storeId===store.id && o.status==='pendente');
  const badge = document.getElementById('dash-pending-orders');
  if (pending.length) { badge.style.display='inline'; badge.textContent=pending.length+' novo'+(pending.length>1?'s':'')+'!'; }
  else { badge.style.display='none'; }
  renderDashContent();
}

function switchDashTab(tab) {
  currentDashTab = tab;
  document.querySelectorAll('.dash-tab').forEach((t,i)=>{
    t.classList.toggle('active', ['produtos','pedidos','loja'][i]===tab);
  });
  renderDashContent();
}

function renderDashContent() {
  const div = document.getElementById('dash-content');
  if (currentDashTab==='produtos') div.innerHTML = renderDashProducts();
  else if (currentDashTab==='pedidos') div.innerHTML = renderDashOrders();
  else div.innerHTML = renderDashSettings();
}

function renderDashProducts() {
  const prods = DB.products().filter(p=>p.storeId===currentDashStoreId);
  return `<button class="btn-new-product" onclick="openProductForm()">+ Novo Produto</button>`
    + (!prods.length
      ? '<div class="empty-state"><div class="empty-icon">📦</div><p>Nenhum produto ainda<br>Adicione produtos para começar a vender</p></div>'
      : prods.map(p=>`<div class="prod-manage-card">
          <div class="prod-manage-row">
            <div class="prod-manage-img">${p.imageUrl?`<img src="${p.imageUrl}"/>`:'🛍️'}</div>
            <div class="prod-manage-info">
              <div style="display:flex;align-items:center;gap:6px">
                <div class="prod-manage-name">${p.name}</div>
                <span class="prod-status-badge ${p.isActive?'active':'inactive'}">${p.isActive?'Ativo':'Inativo'}</span>
              </div>
              ${p.description?`<div style="font-size:12px;color:#6b7280;margin-top:2px">${p.description}</div>`:''}
              <div class="prod-manage-price">${fmt(p.price)}</div>
              <div class="prod-manage-stock">Estoque: ${p.stock}</div>
            </div>
          </div>
          <div class="prod-actions">
            <button class="prod-action-btn edit" onclick="openProductForm(${p.id})">Editar</button>
            <button class="prod-action-btn del" onclick="deleteProduct(${p.id})">Remover</button>
          </div>
        </div>`).join(''));
}

function renderDashOrders() {
  const orders = DB.orders().filter(o=>o.storeId===currentDashStoreId).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
  if (!orders.length) return '<div class="empty-state"><div class="empty-icon">📋</div><p>Nenhum pedido ainda</p></div>';
  return orders.map(o=>{
    const color = statusColors[o.status]||'#aaa';
    const label = statusLabels[o.status]||o.status;
    const ns = nextStatus[o.status];
    const nsLabel = nextStatusLabel[o.status];
    return `<div class="order-card">
      <div class="order-header">
        <div>
          <div class="order-id">Pedido #${o.id}</div>
          <div class="order-client">${o.userName}</div>
          <div class="order-date">${new Date(o.createdAt).toLocaleString('pt-BR')}</div>
        </div>
        <span class="status-badge" style="background:${color}">${label}</span>
      </div>
      <div class="order-items-text">${o.items.map(i=>`${i.qty}× ${i.name} — ${fmt(i.unitPrice*i.qty)}`).join('<br>')}</div>
      <div class="order-footer">
        <div>
          <div class="order-address">📍 ${o.deliveryAddress}</div>
          <div class="order-total">Total: ${fmt(o.total)}</div>
          ${Number(o.deliveryFee)>0?`<div style="font-size:11px;color:#aaa">+${fmt(o.deliveryFee)} entrega</div>`:''}
          ${o.notes?`<div style="font-size:11px;color:#aaa;margin-top:2px">Obs: ${o.notes}</div>`:''}
        </div>
        ${ns?`<button class="btn-next-status" onclick="advanceOrder(${o.id})">${nsLabel}</button>`:''}
      </div>
    </div>`;
  }).join('');
}

function renderDashSettings() {
  const store = DB.stores().find(s=>s.id===currentDashStoreId);
  if (!store) return '';
  return `
    <div class="store-settings-card">
      <div class="store-settings-title">Status da loja</div>
      <div class="toggle-row">
        <div>
          <div class="toggle-label">${store.isOpen!==false?'✅ Aberta':'❌ Fechada'}</div>
          <div class="toggle-sub">${store.isOpen!==false?'Recebendo pedidos':'Não recebendo pedidos'}</div>
        </div>
        <div class="toggle-track ${store.isOpen!==false?'on':''}" onclick="toggleStoreOpen()"></div>
      </div>
    </div>
    <div class="store-settings-card">
      <div class="store-settings-title">Entrega</div>
      <div class="field-group" style="margin-bottom:10px">
        <label class="field-label">Taxa de entrega (R$)</label>
        <input type="number" class="field-input" id="store-fee-input" min="0" step="0.01" value="${Number(store.deliveryFee||0)}" onblur="updateStoreField('deliveryFee',this.value)" />
      </div>
      <div class="field-group">
        <label class="field-label">Área de entrega</label>
        <input type="text" class="field-input" id="store-radius-input" value="${store.deliveryRadius||''}" placeholder="Ex: 5km, Bairro Centro" onblur="updateStoreField('deliveryRadius',this.value)" />
      </div>
    </div>
    <div class="store-settings-card">
      <div class="store-settings-title">Informações</div>
      <div style="font-size:13px;color:#6b7280">
        <div style="display:flex;justify-content:space-between;padding:4px 0"><span>Categoria</span><span>${store.categoria}</span></div>
        <div style="display:flex;justify-content:space-between;padding:4px 0"><span>Endereço</span><span style="max-width:55%;text-align:right;font-size:11px">${store.lat?`${store.lat.toFixed(4)}, ${store.lng.toFixed(4)}`:'Não definido'}</span></div>
      </div>
    </div>`;
}
  function toggleStoreOpen() {
  const stores=DB.stores(); const idx=stores.findIndex(s=>s.id===currentDashStoreId);
  if(idx===-1) return;
  stores[idx].isOpen=!(stores[idx].isOpen!==false);
  DB.saveStores(stores);
  renderDashContent(); renderLojas();
}

function updateStoreField(field, val) {
  const stores=DB.stores(); const idx=stores.findIndex(s=>s.id===currentDashStoreId);
  if(idx===-1) return;
  stores[idx][field] = field==='deliveryFee' ? parseFloat(val)||0 : val.trim()||null;
  DB.saveStores(stores);
  renderLojas();
}

function advanceOrder(orderId) {
  const orders=DB.orders(); const idx=orders.findIndex(o=>o.id===orderId);
  if(idx===-1) return;
  const ns=nextStatus[orders[idx].status];
  if(!ns) return;
  orders[idx].status=ns;
  DB.saveOrders(orders);
  renderDashContent(); renderDash();
}

function deleteProduct(pid) {
  if(!confirm('Remover este produto?')) return;
  const prods=DB.products(); DB.saveProducts(prods.filter(p=>p.id!==pid));
  renderDashContent(); renderDash();
}

// ===== PRODUCT FORM =====
function openProductForm(pid) {
  editingProductId = pid||null;
  prodImgDataUrl = null;
  document.getElementById('product-modal-title').textContent = pid ? 'Editar Produto' : 'Novo Produto';
  document.getElementById('btn-save-product').textContent = pid ? 'Salvar alterações' : 'Criar produto';
  document.getElementById('prod-img-preview').style.display='none';
  document.getElementById('prod-upload-label').textContent='Adicionar foto';
  hideErr('product-error');
  if (pid) {
    const p = DB.products().find(x=>x.id===pid);
    if (!p) return;
    document.getElementById('prod-name').value=p.name;
    document.getElementById('prod-desc').value=p.description||'';
    document.getElementById('prod-price').value=p.price;
    document.getElementById('prod-stock').value=p.stock;
    document.getElementById('prod-fee').value=Number(p.deliveryFee||0);
    if (p.imageUrl) {
      const img=document.getElementById('prod-img-preview');
      img.src=p.imageUrl; img.style.display='block';
      document.getElementById('prod-upload-label').textContent='';
      prodImgDataUrl=p.imageUrl;
    }
  } else {
    ['prod-name','prod-desc','prod-fee'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('prod-price').value='';
    document.getElementById('prod-stock').value='0';
  }
  document.getElementById('product-modal').classList.add('open');
}

function saveProduct() {
  const name=document.getElementById('prod-name').value.trim();
  const price=parseFloat(document.getElementById('prod-price').value);
  const stock=parseInt(document.getElementById('prod-stock').value)||0;
  if (!name) { showErr('product-error','Informe o nome do produto.'); return; }
  if (isNaN(price)||price<0) { showErr('product-error','Informe um preço válido.'); return; }
  const products=DB.products();
  if (editingProductId) {
    const idx=products.findIndex(p=>p.id===editingProductId);
    if (idx!==-1) {
      products[idx]={ ...products[idx], name, description:document.getElementById('prod-desc').value.trim()||null, price, stock, imageUrl:prodImgDataUrl||products[idx].imageUrl, deliveryFee:parseFloat(document.getElementById('prod-fee').value)||0 };
    }
  } else {
    products.push({ id:DB.nextId(products), storeId:currentDashStoreId, name, description:document.getElementById('prod-desc').value.trim()||null, price, stock, imageUrl:prodImgDataUrl||null, deliveryFee:parseFloat(document.getElementById('prod-fee').value)||0, isActive:true, createdAt:new Date().toISOString() });
  }
  DB.saveProducts(products);
  closeModal('product-modal');
  renderDashContent(); renderDash();
  showToast(editingProductId?'✅ Produto atualizado!':'✅ Produto criado!');
}

// ===== MAPA =====
function initMap() {
  mapInitialized=true;
  const def=[-9.5,-37.5];
  leafletMap=L.map('map',{zoomControl:false}).setView(def,13);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(leafletMap);
  const icon=L.divIcon({html:'<div style="width:16px;height:16px;background:#FF6B00;border-radius:50%;border:3px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.3)"></div>',iconSize:[16,16],iconAnchor:[8,8],className:''});
  function place(lat,lng) {
    window._userPos=[lat,lng];
    L.marker([lat,lng],{icon}).addTo(leafletMap).bindPopup('Você está aqui');
    L.circle([lat,lng],{radius:500,color:'#FF6B00',fillColor:'#FF6B00',fillOpacity:0.08,weight:1.5}).addTo(leafletMap);
    leafletMap.setView([lat,lng],14);
    addMapMarkers();
  }
  if (navigator.geolocation) navigator.geolocation.getCurrentPosition(p=>place(p.coords.latitude,p.coords.longitude),()=>place(def[0],def[1]));
  else place(def[0],def[1]);
  updateMapaPills();
  renderMapAll();
}

async function addMapMarkers() {
  if (window._lojaMarkers) window._lojaMarkers.forEach(m=>m.remove());
  window._lojaMarkers=[];
  if (window._motoboyMarkers) window._motoboyMarkers.forEach(m=>m.remove());
  window._motoboyMarkers=[];
  const base=window._userPos||[-9.5,-37.5];

  // Store markers
  DB.stores().forEach((s,i)=>{
    const lat=s.lat||(base[0]+(i*0.002-0.001)), lng=s.lng||(base[1]+(i*0.003-0.001));
    const icon=L.divIcon({html:`<div style="width:32px;height:32px;background:linear-gradient(135deg,#FF8C00,#FF5000);border-radius:8px;border:2px solid white;display:flex;align-items:center;justify-content:center;font-size:16px;box-shadow:0 2px 6px rgba(0,0,0,0.3)">${catEmojis[s.categoria]||'🏪'}</div>`,iconSize:[32,32],iconAnchor:[16,16],className:''});
    const m=L.marker([lat,lng],{icon}).addTo(leafletMap).bindPopup(`<b>${s.nome}</b><br>${s.categoria}`);
    window._lojaMarkers.push(m);
  });

  // Motoboy markers — fetch from server (cross-device)
  const data = await apiFetch('/motoboys');
  const serverMotoboys = data?.motoboys || [];
  serverMotoboys.forEach((mb,i)=>{
    const lat=mb.lat||(base[0]+(i*0.003+0.002)), lng=mb.lng||(base[1]+(i*0.004+0.001));
    const icon=L.divIcon({html:`<div style="width:36px;height:36px;background:linear-gradient(135deg,#22c55e,#16a34a);border-radius:50%;border:2px solid white;display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:0 2px 8px rgba(34,197,94,0.5)">🛵</div>`,iconSize:[36,36],iconAnchor:[18,18],className:''});
    const m=L.marker([lat,lng],{icon}).addTo(leafletMap);
    m.on('click',()=>openRideModal(mb.userId, mb.userName, lat, lng));
    window._motoboyMarkers.push(m);
  });
  updateMapaPills();
}

async function updateMapaPills() {
  const stores = DB.stores();
  const lCount = document.getElementById('mpill-lojas-count');
  const mCount = document.getElementById('mpill-motoboys-count');
  if(lCount) lCount.textContent = stores.length;
  // Fetch real count from server
  const data = await apiFetch('/motoboys');
  const online = data?.motoboys?.length || 0;
  if(mCount) mCount.textContent = online;
}

function setMapaFilter(filter, btn) {
  mapaFilter = filter;
  document.querySelectorAll('.mapa-pill').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  renderMapAll();
}

function filterMapaAll(q) {
  mapaSearchQ = q;
  renderMapAll();
}

async function renderMapAll() {
  const stores = DB.stores().filter(s=>!mapaSearchQ||s.nome.toLowerCase().includes(mapaSearchQ.toLowerCase()));
  const title = document.getElementById('mapa-nearby-title');
  const cnt = document.getElementById('mapa-count');
  const list = document.getElementById('mapa-list');
  const empty = document.getElementById('mapa-empty');

  // Fetch online motoboys from server
  const mbData = await apiFetch('/motoboys');
  const serverMotoboys = (mbData?.motoboys||[]).filter(mb=>!mapaSearchQ||mb.userName.toLowerCase().includes(mapaSearchQ.toLowerCase()));

  let html = '';
  let count = 0;

  if (mapaFilter === 'tudo' || mapaFilter === 'lojas') {
    stores.forEach(s=>{
      count++;
      html+=`<div class="loja-card" onclick="openStore(${s.id})">
        <div class="loja-logo">${s.logo?`<img src="${s.logo}"/>`:(catEmojis[s.categoria]||'🏪')}</div>
        <div class="loja-info"><div class="loja-name">${s.nome}</div><div class="loja-cat">${catEmojis[s.categoria]||'📦'} ${s.categoria}</div></div>
        <div class="loja-badge ${s.isOpen!==false?'open':'closed'}">${s.isOpen!==false?'Aberta':'Fechada'}</div>
      </div>`;
    });
  }

  if (mapaFilter === 'tudo' || mapaFilter === 'motoboys') {
    serverMotoboys.forEach(mb=>{
      count++;
      html+=`<div class="motoboy-card" onclick="openRideModal(${mb.userId},'${mb.userName.replace(/'/g,'&apos;')}',${mb.lat||0},${mb.lng||0})">
        <div class="motoboy-avatar">🛵</div>
        <div class="motoboy-info">
          <div class="motoboy-name">${mb.userName}</div>
          <div class="motoboy-status"><div class="motoboy-dot"></div> Online agora</div>
        </div>
        <span class="motoboy-badge">Pedir corrida</span>
      </div>`;
    });
  }

  if (title) title.textContent = mapaFilter==='motoboys'?'Entregadores Online':mapaFilter==='lojas'?'Lojas Perto de Você':'Tudo Perto de Você';
  if (cnt) cnt.textContent = count+(count===1?' item':' itens');

  if (!count) { empty.style.display='flex'; list.style.display='none'; }
  else { empty.style.display='none'; list.style.display='flex'; list.innerHTML=html; }
}

// kept for back-compat
function renderMapList(stores) { renderMapAll(); }

// ===== HELPERS =====
function showErr(id,msg) { const el=document.getElementById(id); el.textContent=msg; el.style.display='block'; }
function hideErr(id) { const el=document.getElementById(id); if(el){el.style.display='none';el.textContent='';} }
function showToast(msg) { const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),3000); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

// ===== INIT =====
setTimeout(()=>{
  const uid=DB.session();
  if (uid) {
    const user=DB.users().find(u=>u.id===uid);
    if (user) { currentUser=user; enterApp(); return; }
  }
  showPage('page-login');
}, 2700);

// ===== CHAT SYSTEM =====
