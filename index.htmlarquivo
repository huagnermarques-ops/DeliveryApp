const CHAT_QUICK_SUPPORT = ['Como rastrear meu pedido?','Como criar uma loja?','Como pedir corrida com motoboy?'];
const CHAT_QUICK_STORE   = ['Qual o prazo de entrega?','Meu pedido saiu?','Vocês aceitam pix?'];
const CHAT_QUICK_MOTOBOY = ['Você está disponível?','Qual a área que você atende?','Quando você chega?'];

let chatLoading = false;
let currentChatKey = null; // 'support' | 'store_<id>'

// DB extension for chats
DB.chats    = () => DB.get('chats') || {};
DB.saveChats = v => DB.set('chats', v);

function chatTimestamp(ts) {
  if (!ts) return '';
  const d = new Date(ts);
  const now = new Date();
  if (d.toDateString()===now.toDateString()) return d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
  return d.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit'});
}

function renderChatList() {
  if (!currentUser) return;
  // Update support last message
  const chats = DB.chats();
  const supMsgs = chats['support'] || [];
  if (supMsgs.length) {
    const last = supMsgs[supMsgs.length-1];
    const el = document.getElementById('support-last-msg');
    if (el) el.textContent = last.text.substring(0,60);
    const te = document.getElementById('support-last-time');
    if (te) te.textContent = chatTimestamp(last.ts);
  }

  // Render store conversations — from orders
  const storeList = document.getElementById('stores-chat-list');
  if (storeList) {
    const orders = DB.orders().filter(o => o.userId === currentUser.id);
    const storeIds = [...new Set(orders.map(o=>o.storeId))];
    if (!storeIds.length) {
      storeList.innerHTML = `<div style="text-align:center;padding:24px;color:#bbb;font-size:13px">Faça um pedido para iniciar<br>uma conversa com uma loja</div>`;
    } else {
      const stores = DB.stores();
      storeList.innerHTML = storeIds.map(sid => {
        const store = stores.find(s=>s.id===sid);
        if (!store) return '';
        const key = 'store_'+sid;
        const msgs = chats[key] || [];
        const last = msgs.length ? msgs[msgs.length-1] : null;
        const avatarHtml = store.logo ? `<img src="${store.logo}"/>` : (catEmojis[store.categoria]||'🏪');
        return `<div class="chat-conv-card" onclick="openChat('${key}')">
          <div class="chat-conv-avatar">${avatarHtml}</div>
          <div class="chat-conv-info">
            <div class="chat-conv-name">${store.nome}</div>
            <div class="chat-conv-last">${last ? last.text.substring(0,55) : 'Toque para enviar uma mensagem'}</div>
          </div>
          <div class="chat-conv-time">${last ? chatTimestamp(last.ts) : ''}</div>
        </div>`;
      }).join('');
    }
  }

  // Render motoboy conversations — online motoboys
  const motoList = document.getElementById('motoboys-chat-list');
  if (motoList) {
    const onlineMotoboys = DB.motoboys().filter(mb => mb.isOnline);
    if (!onlineMotoboys.length) {
      motoList.innerHTML = `<div style="text-align:center;padding:24px;color:#bbb;font-size:13px">Nenhum entregador online agora</div>`;
    } else {
      motoList.innerHTML = onlineMotoboys.map(mb => {
        const key = 'motoboy_'+mb.id;
        const msgs = chats[key] || [];
        const last = msgs.length ? msgs[msgs.length-1] : null;
        return `<div class="chat-conv-card" onclick="openChat('${key}')">
          <div class="chat-conv-avatar" style="background:linear-gradient(135deg,#22c55e,#16a34a)">🛵</div>
          <div class="chat-conv-info">
            <div class="chat-conv-name">${mb.userName} <span style="color:#22c55e;font-size:11px;font-weight:600">● Online</span></div>
            <div class="chat-conv-last">${last ? last.text.substring(0,55) : 'Toque para conversar ou pedir corrida'}</div>
          </div>
          <div class="chat-conv-time">${last ? chatTimestamp(last.ts) : ''}</div>
        </div>`;
      }).join('');
    }
  }
}

function openChat(key) {
  currentChatKey = key;
  const chats = DB.chats();
  const isSupport = key === 'support';
  const isMotoboy = key.startsWith('motoboy_');
  const motoboyId = isMotoboy ? parseInt(key.replace('motoboy_','')) : null;
  const motoboy = motoboyId ? DB.motoboys().find(mb=>mb.id===motoboyId) : null;
  const storeId = (!isSupport && !isMotoboy) ? parseInt(key.replace('store_','')) : null;
  const store = storeId ? DB.stores().find(s=>s.id===storeId) : null;

  // Header
  const avatarEl = document.getElementById('chat-open-avatar');
  const nameEl   = document.getElementById('chat-open-name');
  if (isSupport) {
    avatarEl.innerHTML = '🤖';
    avatarEl.style.background = 'linear-gradient(135deg,#FF9A00,#FF5000)';
    nameEl.textContent = 'Suporte LocalFlow';
  } else if (isMotoboy) {
    avatarEl.innerHTML = '🛵';
    avatarEl.style.background = 'linear-gradient(135deg,#22c55e,#16a34a)';
    nameEl.textContent = motoboy?.userName || 'Entregador';
  } else {
    avatarEl.innerHTML = store?.logo ? `<img src="${store.logo}" style="width:100%;height:100%;object-fit:cover;border-radius:12px"/>` : (catEmojis[store?.categoria]||'🏪');
    avatarEl.style.background = '';
    nameEl.textContent = store?.nome || 'Loja';
  }

  // Quick buttons
  const quickRow = document.getElementById('chat-quick-row');
  const quickBtns = isSupport ? CHAT_QUICK_SUPPORT : isMotoboy ? CHAT_QUICK_MOTOBOY : CHAT_QUICK_STORE;
  const msgs = chats[key] || [];
  quickRow.innerHTML = msgs.length===0
    ? quickBtns.map(q=>`<button class="chat-quick-btn" onclick="chatSendText('${q.replace(/'/g,"&#39;")}')">${q}</button>`).join('')
    : '';

  // Show chat screen
  document.getElementById('chat-list-view').style.display = 'none';
  const screen = document.getElementById('chat-open-view');
  screen.classList.add('active');

  renderChatMessages();
  setTimeout(()=>document.getElementById('chat-input')?.focus(),200);
}

function closeChat() {
  currentChatKey = null;
  document.getElementById('chat-list-view').style.display = 'flex';
  document.getElementById('chat-open-view').classList.remove('active');
  renderChatList();
}

function renderChatMessages() {
  const key = currentChatKey;
  const chats = DB.chats();
  const msgs = chats[key] || [];
  const isSupport = key === 'support';
  const el = document.getElementById('chat-messages');
  if (!el) return;

  if (!msgs.length) {
    el.innerHTML = `<div style="text-align:center;color:#bbb;font-size:13px;margin-top:24px">${isSupport?'👋 Olá! Como posso ajudar?':'👋 Diga olá para a loja!'}</div>`;
    return;
  }

  const isMotoboy = key.startsWith('motoboy_');
  el.innerHTML = msgs.map(m => {
    const isMe = m.from === 'user';
    let avatarHtml = '';
    if (!isMe) {
      if (isSupport) avatarHtml = '🤖';
      else if (isMotoboy) avatarHtml = '🛵';
      else avatarHtml = '🏪';
    }
    return `<div class="chat-msg ${isMe?'me':''}">
      ${!isMe?`<div class="chat-msg-avatar">${avatarHtml}</div>`:''}
      <div>
        <div class="chat-bubble ${isMe?'me':'them'}">${m.text.replace(/\n/g,'<br>')}</div>
        <div class="chat-bubble-time">${chatTimestamp(m.ts)}</div>
      </div>
    </div>`;
  }).join('');
  el.scrollTop = el.scrollHeight;
}

function chatKey(e) { if(e.key==='Enter') chatSend(); }

function chatSendText(text) {
  const input = document.getElementById('chat-input');
  if (input) input.value = text;
  chatSend();
}

async function chatSend() {
  const input = document.getElementById('chat-input');
  const text = (input?.value || '').trim();
  if (!text || chatLoading) return;
  input.value = '';

  const key = currentChatKey;
  const chats = DB.chats();
  if (!chats[key]) chats[key] = [];
  chats[key].push({ from:'user', text, ts: Date.now() });
  DB.saveChats(chats);

  // Hide quick buttons after first message
  document.getElementById('chat-quick-row').innerHTML = '';

  const isSupport = key === 'support';
  renderChatMessages();

  if (key.startsWith('motoboy_')) {
    // Motoboy auto-reply
    chatLoading = true;
    await new Promise(r=>setTimeout(r,800));
    chatLoading = false;
    const t = text.toLowerCase();
    let rep;
    if (/disponível|disponivel|livre|aí|ai/i.test(t)) rep = '✅ Sim! Estou disponível agora. Pode pedir corrida pelo mapa! 🛵';
    else if (/área|area|bairro|onde|atend/i.test(t)) rep = '📍 Atendo toda a região. Veja no mapa onde estou agora!';
    else if (/quanto|preço|valor|custo|cobr/i.test(t)) rep = '💰 O preço é calculado pela distância. Veja ao clicar no meu marcador no mapa!';
    else if (/chega|quando|tempo|demora/i.test(t)) rep = '⏱️ Chego em aproximadamente 5–15 minutos, dependendo da rota!';
    else if (/oi|olá|ola|bom dia|boa/i.test(t)) rep = 'Olá! 👋 Sou entregador no LocalFlow. Precisa de uma corrida? Clique no meu marcador no mapa! 🗺️';
    else rep = '😊 Claro! Para pedir corrida, toque no meu marcador verde no mapa. Estou disponível!';
    const ch2 = DB.chats();
    if (!ch2[key]) ch2[key] = [];
    ch2[key].push({ from:'motoboy', text:rep, ts:Date.now() });
    DB.saveChats(ch2);
    renderChatMessages();
    return;
  }

  if (!isSupport) {
    // Simulate store auto-reply
    chatLoading = true;
    await new Promise(r=>setTimeout(r,900));
    chatLoading = false;
    const storeReplies = [
      '✅ Recebemos sua mensagem! Em breve retornamos.',
      '😊 Olá! Obrigado por entrar em contato.',
      '🛵 Seu pedido está sendo preparado com carinho!',
      '💬 Pode perguntar à vontade!',
      '⏱️ Tempo estimado: 30–45 minutos.',
      '💳 Aceitamos dinheiro e pix!',
    ];
    const reply = storeReplies[Math.floor(Math.random()*storeReplies.length)];
    const ch2 = DB.chats();
    if (!ch2[key]) ch2[key] = [];
    ch2[key].push({ from:'store', text:reply, ts:Date.now() });
    DB.saveChats(ch2);
    renderChatMessages();
    return;
  }

  // Support FAQ answer
  chatLoading = true;
  await new Promise(r=>setTimeout(r,600));
  chatLoading = false;
  let answer = null;
  for(const f of CHAT_FAQ) { if(f.q.test(text)) { answer=f.a; break; } }
  if (!answer) {
    const t = text.toLowerCase();
    if (/erro|bug|falha|travou|nao funciona|não funciona/i.test(t))
      answer='⚠️ Pode me explicar melhor o problema? Tente descrever o que aconteceu e em qual tela. Nosso time de suporte está de olho! 🛠️';
    else if (/pedido|compra/i.test(t))
      answer='📦 Para ver seus pedidos, vá em Perfil → Meus Pedidos. Lá você acompanha status, produtos e o lojista.';
    else if (/loja|estabelecimento|mercado|restaurante/i.test(t))
      answer='🏪 Acesse a aba Lojas para ver todos os estabelecimentos. Para gerenciar a sua, ative o Perfil Mercantil no seu Perfil.';
    else if (/demor|atraso|sumiu|cadê/i.test(t))
      answer='⏱️ Há variações no tempo de entrega. Verifique o status em Meus Pedidos. Se demorar muito, contate o lojista pelo Chat da loja.';
    else if (/mapa|entregador|moto/i.test(t))
      answer='🗺️ Na aba Mapa você vê lojas e entregadores em tempo real. Clique no ícone verde de um motoboy para pedir corrida!';
    else if (/app|aplicativo|versão|atualiz/i.test(t))
      answer='📱 O LocalFlow roda direto no navegador — sempre atualizado. Sem instalação necessária!';
    else
      answer='🤖 Não entendi ainda, mas quero ajudar! Tente reformular ou escolha um dos atalhos acima. Para suporte direto: suporte@localflow.app';
  }
  const ch3 = DB.chats();
  if (!ch3[key]) ch3[key] = [];
  ch3[key].push({ from:'bot', text:answer, ts:Date.now() });
  DB.saveChats(ch3);
  renderChatMessages();
}

function spAsk(q) {
  document.getElementById('sp-input').value=q;
  spSend();
}

function spKey(e) { if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();spSend();} }

function toggleSupport() {
  spOpen=!spOpen;
  const btn=document.getElementById('support-btn');
  const panel=document.getElementById('support-panel');
  btn.classList.toggle('open',spOpen);
  panel.classList.toggle('open',spOpen);
  btn.textContent=spOpen?'✕':'💬';
  if(spOpen){ spRender(); setTimeout(()=>document.getElementById('sp-input')?.focus(),300); }
}

// ===== RIDE REQUEST SYSTEM =====
let _rideMotoboyUserId = null;   // server userId of selected motoboy
let _rideMotoboyName   = null;
let _rideMotoboyLat    = null;
let _rideMotoboyLng    = null;
let _pendingRideId     = null;   // string id returned by server (client side)
let _activeRideId      = null;   // string id of pending ride shown to motoboy
let _activeRideObj     = null;   // full ride object for route display
let _routeControl      = null;
let _ridePollingTimer  = null;

function haversine(lat1,lng1,lat2,lng2) {
  const R=6371; const toR=x=>x*Math.PI/180;
  const dLat=toR(lat2-lat1), dLng=toR(lng2-lng1);
  const a=Math.sin(dLat/2)**2+Math.cos(toR(lat1))*Math.cos(toR(lat2))*Math.sin(dLng/2)**2;
  return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}

function estimatePrice(distKm) {
  const base=5; const perKm=2.5;
  return Math.max(base, base + distKm*perKm);
}

function openRideModal(motoboyUserId, motoboyName, mbLat, mbLng) {
  if (!currentUser) { showToast('Faça login para pedir corrida'); return; }
  _rideMotoboyUserId = motoboyUserId;
  _rideMotoboyName   = motoboyName;
  _rideMotoboyLat    = mbLat;
  _rideMotoboyLng    = mbLng;

  document.getElementById('ride-moto-name').textContent = motoboyName || 'Entregador';

  const userPos = window._userPos || [-9.5,-37.5];
  const dist = (mbLat && mbLng) ? haversine(userPos[0],userPos[1], mbLat, mbLng) : 2;
  const price = estimatePrice(dist);
  document.getElementById('ride-price-val').textContent = 'R$ '+price.toFixed(2).replace('.',',');
  document.getElementById('ride-dest').value = '';
  hideErr('ride-error');

  document.getElementById('ride-modal').classList.add('open');
}

function closeRideModal() {
  document.getElementById('ride-modal').classList.remove('open');
  _rideMotoboyUserId = null;
}

async function submitRideRequest() {
  const dest = document.getElementById('ride-dest').value.trim();
  if (!dest) { showErr('ride-error','Informe o destino da corrida.'); return; }
  if (!_rideMotoboyUserId) return;

  const priceText = document.getElementById('ride-price-val').textContent;
  const btn = document.querySelector('.btn-pedir-corrida');
  if (btn) btn.textContent = '⏳ Enviando...';

  const result = await apiFetch('/rides', {
    method: 'POST',
    body: JSON.stringify({
      userId: currentUser.id,
      userName: currentUser.name,
      motoboyUserId: _rideMotoboyUserId,
      motoboyName: _rideMotoboyName,
      motoboyLat: _rideMotoboyLat,
      motoboyLng: _rideMotoboyLng,
      dest,
      price: priceText,
    }),
  });

  if (btn) btn.textContent = '🛵 Pedir Corrida';
  if (!result?.ride) { showErr('ride-error','Erro ao solicitar. Tente novamente.'); return; }

  _pendingRideId = result.ride.id;
  closeRideModal();
  showToast('🛵 Corrida solicitada! Aguarde o motoboy aceitar.');
  startRidePolling();
}

// ===== MOTOBOY ACCEPT / REJECT =====
async function acceptRide() {
  const banner = document.getElementById('motoboy-ride-banner');
  if (!_activeRideId || !_activeRideObj) return;
  const result = await apiFetch('/rides/'+_activeRideId, {
    method: 'PATCH',
    body: JSON.stringify({ status: 'accepted' }),
  });
  if (!result?.ok) { showToast('Erro ao aceitar. Tente novamente.'); return; }
  banner.style.display = 'none';
  showToast('✅ Corrida aceita! Rota carregando...');
  const rideForRoute = _activeRideObj;
  _activeRideId  = null;
  _activeRideObj = null;
  switchTab('mapa');
  setTimeout(()=>showRouteOnMap(rideForRoute), 600);
}

async function rejectRide() {
  const banner = document.getElementById('motoboy-ride-banner');
  if (!_activeRideId) return;
  await apiFetch('/rides/'+_activeRideId, {
    method: 'PATCH',
    body: JSON.stringify({ status: 'rejected' }),
  });
  banner.style.display = 'none';
  _activeRideId  = null;
  _activeRideObj = null;
  showToast('❌ Corrida recusada.');
}

function showRouteOnMap(ride) {
  if (!leafletMap) return;
  if (_routeControl) { try { leafletMap.removeControl(_routeControl); } catch(e){} _routeControl=null; }

  const from = [ride.motoboyLat, ride.motoboyLng];
  // Destination: use user pos as destination approximation
  const userPos = window._userPos || [-9.5,-37.5];
  const to = [userPos[0]+0.003, userPos[1]+0.004]; // slight offset so it draws a route

  if (window.L && L.Routing) {
    _routeControl = L.Routing.control({
      waypoints: [L.latLng(from[0],from[1]), L.latLng(to[0],to[1])],
      routeWhileDragging: false,
      addWaypoints: false,
      createMarker: ()=>null,
      lineOptions: { styles:[{color:'#FF6B00',weight:5,opacity:0.85}] },
      show: false,
    }).addTo(leafletMap);

    _routeControl.on('routesfound', e=>{
      const dist = (e.routes[0].summary.totalDistance/1000).toFixed(1);
      const time = Math.round(e.routes[0].summary.totalTime/60);
      document.getElementById('route-dist-label').textContent = `📏 ${dist} km · ⏱️ ~${time} min`;
    });
  }

  leafletMap.setView(from, 15);
  document.getElementById('route-dest-label').textContent = '📍 Destino: '+ride.dest;
  document.getElementById('route-panel').style.display = 'block';
}

function closeRoute() {
  if (_routeControl && leafletMap) {
    try { leafletMap.removeControl(_routeControl); } catch(e){}
    _routeControl = null;
  }
  document.getElementById('route-panel').style.display = 'none';
}

function finishRide() {
  closeRoute();
  showToast('🎉 Entrega concluída! Obrigado.');
}

// ===== POLLING =====

// CLIENT: polls server until ride is accepted/rejected
function startRidePolling() {
  if (_ridePollingTimer) clearInterval(_ridePollingTimer);
  _ridePollingTimer = setInterval(async ()=>{
    if (!currentUser || !_pendingRideId) { clearInterval(_ridePollingTimer); return; }
    const data = await apiFetch('/rides/'+_pendingRideId);
    if (!data?.ride) return;
    const { status } = data.ride;
    if (status === 'accepted') {
      clearInterval(_ridePollingTimer);
      _pendingRideId = null;
      showToast('🎉 Motoboy aceitou sua corrida! Veja o mapa.');
      switchTab('mapa');
      setTimeout(()=>showRouteOnMap(data.ride), 600);
    } else if (status === 'rejected') {
      clearInterval(_ridePollingTimer);
      _pendingRideId = null;
      showToast('😔 O motoboy não pôde aceitar agora. Tente outro entregador.');
    }
  }, 4000);
}

// MOTOBOY: polls server every 5s for pending rides directed at them
setInterval(async ()=>{
  if (!currentUser || !motoboyOn || !motoboyIsOnline) return;
  const data = await apiFetch('/rides/pending?motoboyUserId='+currentUser.id);
  if (!data?.ride) return;
  const pending = data.ride;
  if (_activeRideId === pending.id) return; // already showing this
  _activeRideId  = pending.id;
  _activeRideObj = pending;
  document.getElementById('banner-requester').textContent = 'De: '+(pending.userName||'Cliente');
  document.getElementById('banner-dest').textContent = '📍 Destino: '+pending.dest;
  document.getElementById('banner-price').textContent = pending.price;
  document.getElementById('motoboy-ride-banner').style.display = 'block';
}, 5000);

// MOTOBOY HEARTBEAT: keep online status alive every 30s
setInterval(async ()=>{
  if (!currentUser || !motoboyOn || !motoboyIsOnline) return;
  await apiFetch('/motoboys', { method:'POST', body: JSON.stringify({
    userId: currentUser.id, userName: currentUser.name,
    lat: window._userPos?.[0]||0, lng: window._userPos?.[1]||0,
  })});
}, 30000);

// MAP AUTO-REFRESH: update motoboy markers every 8s while mapa tab is active
setInterval(()=>{
  if (_currentTab !== 'mapa' || !mapInitialized) return;
  addMapMarkers();
  renderMapAll();
}, 8000);
</script>
</body>
</html>